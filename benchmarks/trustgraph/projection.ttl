<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-rdf-data-cube/p-use-rdfs-label> a airkg:Practice ;
    prov:wasDerivedFrom doc:w3c-rdf-data-cube ;
    airkg:as_of_date "2014-01-16" ;
    airkg:grounding_span "The RDFS terms for display label (`rdfs:label`) descriptive comment (`rdfs:comment`) *SHOULD* be given as well for compatibility with earlier versions of Data Cube and common RDF practice." ;
