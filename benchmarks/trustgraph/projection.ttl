    airkg:term "blank node identifier" ;
    airkg:verbatim_text "A blank node identifier is a string that can be used as an identifier for a blank node within the scope of a JSON-LD document. Blank node identifiers begin with `_:`." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d30> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A term is a short word defined in a context that may be expanded to an IRI." ;
