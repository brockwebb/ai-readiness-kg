<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/c27> a airkg:Concept ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:description "A term definition whose value is a map of keyword keys." ;
    airkg:grounding_span "An expanded term definition is a term definition where the value is a map containing one or more keyword keys to define the associated IRI, if this is a reverse property, the type associated with string values, and a container mapping." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:name "expanded term definition" ;
