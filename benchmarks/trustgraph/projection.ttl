<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d34> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "The vocabulary mapping is set in the context using the `@vocab` key whose value must be an IRI, a compact IRI, a term, or `null`." ;
