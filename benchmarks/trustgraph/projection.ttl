<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d4> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A dataset representing a collection of RDF graphs including exactly one default graph and zero or more named graphs." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "3f500244d5f84ca2a4e16fe057ba2759" ;
