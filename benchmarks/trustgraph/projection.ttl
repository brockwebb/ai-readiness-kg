<https://brockwebb.github.io/ai-readiness-kg/doc/introducing-the-oecd-ai-capability-indicators/d1> a airkg:Definition ;
    prov:wasDerivedFrom doc:introducing-the-oecd-ai-capability-indicators ;
    airkg:as_of_date "2024" ;
    airkg:grounding_span "a machine-based system that, for explicit or implicit objectives, infers, from the input it receives, how to gene rate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments. Different AI systems vary in their levels of autonomy and adaptiveness after deployment." ;
    airkg:location "Executive Summary, footnote 1" ;
    airkg:normative_status "policy" ;
