    airkg:scope "dataset" ;
    airkg:text "Give rdfs:label and rdfs:comment for DataSets in addition to Dublin Core terms." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-rdf-data-cube/p-use-skos-codes> a airkg:Practice ;
