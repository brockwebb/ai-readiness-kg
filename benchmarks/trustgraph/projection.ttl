<https://brockwebb.github.io/ai-readiness-kg/doc/m-24-18-advancing-the-responsible-acquisition-of-ai-in-gover/d18> a airkg:Definition ;
    prov:wasDerivedFrom doc:m-24-18-advancing-the-responsible-acquisition-of-ai-in-gover ;
    airkg:as_of_date "2024-09-24" ;
    airkg:grounding_relocated_from "the term “derived product” means any asset created during the process of transforming a data asset" ;
    airkg:grounding_relocation_method "deterministic" ;
    airkg:grounding_span "the term “derived product” means any asset created during the process of transforming a data asset (e.g., modifying or enriching through any contractor-performed cleaning, labeling, customization, etc.) for the purposes of training, testing, or validating a model, as well as any AI models, systems, or services developed using a data asset." ;
    airkg:location "footnote 25" ;
    airkg:normative_status "policy" ;
    airkg:prov_extraction_event_id "6f934cf81d724171a744ee07a21e5989" ;
