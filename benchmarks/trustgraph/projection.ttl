    airkg:term "typed value" ;
    airkg:verbatim_text "A typed value consists of a value, which is a string, and a type, which is an IRI." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d33> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A value object is a map that has an `@value` entry." ;
