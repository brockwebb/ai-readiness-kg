<https://brockwebb.github.io/ai-readiness-kg/doc/dcat-us-3-dataset-schema/p_email_format> a airkg:Practice ;
    prov:wasDerivedFrom doc:dcat-us-3-dataset-schema ;
    airkg:applies_to <https://brockwebb.github.io/ai-readiness-kg/doc/dcat-us-3-dataset-schema/c_contact_point> ;
    airkg:grounding_span "Must be formatted as a single mailto: URI (for example, mailto:contact@agency.gov) with no extra text, no subject lines, no multiple addresses, and no trailing spaces." ;
    airkg:location "Glossary: contactPoint.hasEmail" ;
    airkg:prov_extraction_event_id "edda363fda114c78bc58d3895f717ad6" ;
    airkg:prov_model_id "claude-opus-4-8" ;
