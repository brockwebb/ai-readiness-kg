<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/c16> a airkg:Concept ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:description "An IRI expressed as prefix:suffix without a separate term definition." ;
    airkg:grounding_span "A compact IRI has the form of prefix:*suffix* and is used as a way of expressing an IRI without needing to define separate term definitions for each IRI contained within a common vocabulary identified by prefix." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:name "compact IRI" ;
