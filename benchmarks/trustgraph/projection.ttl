<https://brockwebb.github.io/ai-readiness-kg/doc/foundations-for-evidence-based-policymaking-act-of-2018-evid/d21> a airkg:Definition ;
    prov:wasDerivedFrom doc:foundations-for-evidence-based-policymaking-act-of-2018-evid ;
    airkg:as_of_date "2019-01-14" ;
    airkg:grounding_span "means the collection, compilation, processing, or" ;
    airkg:location "§3561(10), 132 STAT. 5545" ;
