<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/c26> a airkg:Concept ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:description "An entry in a context defining a term usable as key, type, or vocabulary item." ;
    airkg:grounding_span "A term definition is an entry in a context, where the key defines a term which may be used within a map as a key, type, or elsewhere that a string is interpreted as a vocabulary item." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:name "term definition" ;
    airkg:prov_extraction_event_id "3f500244d5f84ca2a4e16fe057ba2759" ;
