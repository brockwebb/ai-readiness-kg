    airkg:term "undefined behavior" ;
    airkg:verbatim_text "Behavior described as *undefined* is likely, at least in some circumstances, to result in outcomes that contradict the specification." .

<https://brockwebb.github.io/ai-readiness-kg/doc/openapi-specification-core/d5> a airkg:Definition ;
    prov:wasDerivedFrom doc:openapi-specification-core ;
    airkg:as_of_date "2025-09-19" ;
    airkg:grounding_span "Behavior described as *implementation-defined* allows implementations to choose which of several different-but-compliant approaches to a requirement to implement." ;
