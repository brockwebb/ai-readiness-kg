<https://brockwebb.github.io/ai-readiness-kg/doc/spectral-readme/d-ruleset> a airkg:Definition ;
    prov:wasDerivedFrom doc:spectral-readme ;
    airkg:as_of_date "2026-08-21" ;
    airkg:grounding_span "A ruleset is a JSON, YAML, or JavaScript/TypeScript file (often the file is called `.spectral.yaml` for a YAML ruleset) that contains a collection of rules, which can be used to lint other JSON or YAML files such as an API description." ;
    airkg:location "Usage > 1. Create a local ruleset" ;
    airkg:normative_status "industry" ;
    airkg:prov_extraction_event_id "17698320401d4936b0c30bd71c6d8be4" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.3" ;
    airkg:prov_source_sha256 "26120c2a9560d1f9bf265622ec1cbd6d9796dd13bcd70dfffb887657023f7d01" ;
    airkg:term "Ruleset" ;
    airkg:verbatim_text "A ruleset is a JSON, YAML, or JavaScript/TypeScript file (often the file is called `.spectral.yaml` for a YAML ruleset) that contains a collection of rules, which can be used to lint other JSON or YAML files such as an API description." .

