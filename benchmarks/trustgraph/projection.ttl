    airkg:term "RDF graph" ;
    airkg:verbatim_text "A labeled directed graph, i.e., a set of nodes connected by directed-arcs. Also called linked data graph." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d17> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A resource denoted by an IRI, a blank node or literal representing something in the world (the \"universe of discourse\")." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "3f500244d5f84ca2a4e16fe057ba2759" ;
