<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d1> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "The base IRI is an IRI established in the context, or is based on the JSON-LD document location. The base IRI is used to turn relative IRI references into IRIs." ;
