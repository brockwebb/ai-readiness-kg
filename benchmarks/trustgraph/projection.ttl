<https://brockwebb.github.io/ai-readiness-kg/doc/google-structured-data-intro/def-structured-data> a airkg:Definition ;
    prov:wasDerivedFrom doc:google-structured-data-intro ;
    airkg:as_of_date "2025-12-10" ;
    airkg:grounding_span "Structured data is a standardized format for providing information about a page and classifying the page content; for example, on a recipe page, what are the ingredients, the cooking time and temperature, the calories, and so on." ;
    airkg:location "intro" ;
    airkg:normative_status "industry" ;
    airkg:prov_extraction_event_id "2b16029dca574db3b4a31222aa3efc26" ;
