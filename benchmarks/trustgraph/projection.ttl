<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/c15> a airkg:Concept ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:aliases "@vocab" ;
    airkg:description "A mapping set in the context via @vocab for expanding properties and @type values." ;
    airkg:grounding_span "The vocabulary mapping is set in the context using the `@vocab` key whose value must be an IRI, a compact IRI, a term, or `null`." ;
