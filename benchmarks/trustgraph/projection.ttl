<https://brockwebb.github.io/ai-readiness-kg/doc/mlcommons-croissant-spec/claim-splits-download> a airkg:Claim ;
    prov:wasDerivedFrom doc:mlcommons-croissant-spec ;
    airkg:about <https://brockwebb.github.io/ai-readiness-kg/doc/mlcommons-croissant-spec/c-split> ;
    airkg:claim_text "If a user requests loading only the validation split of COCO 2014, a Croissant tool knows to download val2014.zip but not train2014.zip and test2014.zip." ;
