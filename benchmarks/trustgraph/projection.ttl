<https://brockwebb.github.io/ai-readiness-kg/doc/openapi-specification-core/d3> a airkg:Definition ;
    prov:wasDerivedFrom doc:openapi-specification-core ;
    airkg:as_of_date "2025-09-19" ;
    airkg:grounding_span "Within this specification, a *sequential media type* is defined as any media type that consists of a repeating structure, without any sort of header, footer, envelope, or other metadata in addition to the sequence." ;
    airkg:location "§4.14.3.1" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "a0dad872637a45c380f3f9e963c7cdbf" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.3" ;
    airkg:prov_source_sha256 "158810e334a7d4eae67289d1bce5450787b246689c6dd6b093c15b08b0691df4" ;
    airkg:term "sequential media type" ;
    airkg:verbatim_text "Within this specification, a *sequential media type* is defined as any media type that consists of a repeating structure, without any sort of header, footer, envelope, or other metadata in addition to the sequence." .

<https://brockwebb.github.io/ai-readiness-kg/doc/openapi-specification-core/d4> a airkg:Definition ;
    prov:wasDerivedFrom doc:openapi-specification-core ;
    airkg:as_of_date "2025-09-19" ;
    airkg:grounding_span "Behavior described as *undefined* is likely, at least in some circumstances, to result in outcomes that contradict the specification." ;
