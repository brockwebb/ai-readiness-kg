    airkg:term "property" ;
    airkg:verbatim_text "The name of a directed-arc in a linked data graph. Every property is directional and is labeled with an IRI or a blank node identifier." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d16> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A labeled directed graph, i.e., a set of nodes connected by directed-arcs. Also called linked data graph." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:normative_status "standard" ;
