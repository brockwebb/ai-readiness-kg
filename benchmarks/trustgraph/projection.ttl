<https://brockwebb.github.io/ai-readiness-kg/doc/m-26-04-increasing-public-trust-in-ai-through-unbiased-ai-pr/d3> a airkg:Definition ;
    prov:wasDerivedFrom doc:m-26-04-increasing-public-trust-in-ai-through-unbiased-ai-pr ;
    airkg:as_of_date "2025-07-23" ;
    airkg:grounding_span "shall be truthful in responding to user prompts seeking factual information" ;
    airkg:location "Overview, page 1" ;
    airkg:normative_status "policy" ;
    airkg:prov_extraction_event_id "9cc56e6a43cb4f548750f19222d59862" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.2" ;
    airkg:prov_source_sha256 "d33b0277d720baac843babc5f24269e4c0b8777447870a36309d8b4f3d9c79bc" ;
    airkg:term "Truth-seeking" ;
    airkg:verbatim_text "LLMs shall be truthful in responding to user prompts seeking factual information or analysis. LLMs shall prioritize historical accuracy, scientific inquiry, and objectivity, and shall acknowledge uncertainty where reliable information is incomplete or contradictory." .

<https://brockwebb.github.io/ai-readiness-kg/doc/m-26-04-increasing-public-trust-in-ai-through-unbiased-ai-pr/d4> a airkg:Definition ;
    prov:wasDerivedFrom doc:m-26-04-increasing-public-trust-in-ai-through-unbiased-ai-pr ;
    airkg:as_of_date "2025-07-23" ;
    airkg:grounding_span "LLMs shall be neutral, nonpartisan tools that do not manipulate responses in favor" ;
    airkg:location "Overview, page 1" ;
    airkg:normative_status "policy" ;
    airkg:prov_extraction_event_id "9cc56e6a43cb4f548750f19222d59862" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.2" ;
    airkg:prov_source_sha256 "d33b0277d720baac843babc5f24269e4c0b8777447870a36309d8b4f3d9c79bc" ;
    airkg:term "Ideological Neutrality" ;
    airkg:verbatim_text "LLMs shall be neutral, nonpartisan tools that do not manipulate responses in favor of ideological dogmas. Developers shall not intentionally encode partisan or ideological judgments into an LLM's outputs unless those judgments are prompted by or otherwise readily accessible to the end user." .

