    airkg:term "resource" ;
    airkg:verbatim_text "A resource denoted by an IRI, a blank node or literal representing something in the world (the \"universe of discourse\")." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d18> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A subject is a node in a linked data graph with at least one outgoing edge, related to an object node through a property." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "3f500244d5f84ca2a4e16fe057ba2759" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.3" ;
    airkg:prov_source_sha256 "22b59dff8504a1db8fa6e9c774c470549700ecbe2ae8f5d51dd2e8c215266baf" ;
    airkg:term "subject" ;
    airkg:verbatim_text "A subject is a node in a linked data graph with at least one outgoing edge, related to an object node through a property." .

<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-json-ld-1-1-core/d19> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:as_of_date "2020-07-16" ;
    airkg:grounding_span "A component of an RDF graph including a subject, predicate, and object, which represents a node-arc-node segment of an RDF graph." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "3f500244d5f84ca2a4e16fe057ba2759" ;
    airkg:prov_model_id "claude-opus-4-8" ;
