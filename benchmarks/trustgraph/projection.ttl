    airkg:prov_source_sha256 "8e8abe1cda4b5544652b79392b23631e699552c9a7109eb2123286dfd798226b" ;
    airkg:term "Accuracy and reliability" ;
    airkg:verbatim_text "Accuracy measures the extent to which an estimate from a data product reflects the data's true value. Reliability, a related concept, characterizes the consistency of results when the same phenomenon is measured or estimated more than once under similar conditions." .

