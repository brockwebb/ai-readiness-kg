<https://brockwebb.github.io/ai-readiness-kg/doc/openapi-specification-core/d10> a airkg:Definition ;
    prov:wasDerivedFrom doc:openapi-specification-core ;
    airkg:as_of_date "2025-09-19" ;
    airkg:grounding_span "Path templating refers to the usage of template expressions, delimited by curly braces (`{}`), to mark a section of a URL path as replaceable using path parameters." ;
