<https://brockwebb.github.io/ai-readiness-kg/doc/foundations-for-evidence-based-policymaking-act-of-2018-evid/d15> a airkg:Definition ;
    prov:wasDerivedFrom doc:foundations-for-evidence-based-policymaking-act-of-2018-evid ;
    airkg:as_of_date "2019-01-14" ;
    airkg:grounding_span "The term ‘agent’ means an individual—" ;
    airkg:location "§3561(2), 132 STAT. 5544" ;
    airkg:normative_status "statute" ;
    airkg:prov_extraction_event_id "38e0c9aaa4214cfa9e0a96788bcb29cc" ;
    airkg:prov_model_id "claude-opus-4-8" ;
    airkg:prov_schema_version "0.2" ;
    airkg:prov_source_sha256 "9a9869d01c9a078376bd8e701b7657449f17e921036d6b24d7b03bb0c255c27e" ;
    airkg:term "agent" ;
    airkg:verbatim_text "The term ‘agent’ means an individual— (A)(i) who is an employee of a private organization or a researcher affiliated with an institution of higher learning (including a person granted special sworn status by the Bureau of the Census under section 23(c) of title 13), and with whom a contract or other agreement is executed, on a temporary basis, by an executive agency to perform exclusively statistical activities under the control and supervision of an officer or employee of that agency; ... and (B) who agrees in writing to comply with all provisions of law that affect information acquired by that agency." .

<https://brockwebb.github.io/ai-readiness-kg/doc/foundations-for-evidence-based-policymaking-act-of-2018-evid/d18> a airkg:Definition ;
