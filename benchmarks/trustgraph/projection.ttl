    prov:wasDerivedFrom doc:w3c-json-ld-1-1-core ;
    airkg:description "Core data structures (arrays, maps, strings, numbers, booleans, null) from transforming JSON." ;
    airkg:grounding_span "The JSON-LD internal representation is the result of transforming a JSON syntactic structure into the core data structures suitable for direct processing: arrays, maps, strings, numbers, booleans, and null." ;
    airkg:location "§ 1.4 Terminology" ;
    airkg:name "JSON-LD internal representation" ;
