<https://brockwebb.github.io/ai-readiness-kg/doc/aidrin-hiniduma-2024/cl-bias-discriminatory-outcomes> a airkg:Claim ;
    prov:wasDerivedFrom doc:aidrin-hiniduma-2024 ;
    airkg:about <https://brockwebb.github.io/ai-readiness-kg/doc/aidrin-hiniduma-2024/c-bias> ;
    airkg:claim_text "Unfair biases in datasets can lead to discriminatory outcomes when machine learning models are trained on them, potentially amplifying societal inequalities." ;
    airkg:claim_type "empirical" ;
    airkg:grounding_span "According to Mehrabi et al. [36] unfair biases in datasets can lead to discriminatory outcomes when machine learning models are trained on them, potentially extending and increasing existing societal inequalities." ;
    airkg:location "§4.1.6" ;
    airkg:prov_extraction_event_id "2a246502a54c4bbcaa15c457af12ba93" ;
    airkg:prov_model_id "claude-fable-5" ;
    airkg:prov_schema_version "0.1" .

