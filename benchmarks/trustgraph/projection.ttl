<https://brockwebb.github.io/ai-readiness-kg/doc/fcsm-23-02-a-framework-for-data-quality-case-studies/d-accuracy-reliability> a airkg:Definition ;
    prov:wasDerivedFrom doc:fcsm-23-02-a-framework-for-data-quality-case-studies ;
    airkg:as_of_date "2023-10" ;
    airkg:grounding_span "Accuracy and reliability: Accuracy measures the extent to which an estimate from a data" ;
