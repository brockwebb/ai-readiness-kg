<https://brockwebb.github.io/ai-readiness-kg/doc/w3c-dwbp-2017/def-dataset> a airkg:Definition ;
    prov:wasDerivedFrom doc:w3c-dwbp-2017 ;
    airkg:as_of_date "2017-01-31" ;
    airkg:grounding_span "A dataset is defined as a collection of data, published or curated by a single agent, and available for access or download in one or more formats. A dataset does not have to be available as a downloadable file." ;
    airkg:location "9" ;
    airkg:normative_status "standard" ;
    airkg:prov_extraction_event_id "2f12636d5d3f469b8bcab04a3a0b6599" ;
