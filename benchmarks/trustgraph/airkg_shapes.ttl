@prefix airkg: <https://brockwebb.github.io/ai-readiness-kg/schema#> .
@prefix airkgsh: <https://brockwebb.github.io/ai-readiness-kg/shapes#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

airkgsh:ClaimShape a sh:NodeShape ;
    rdfs:comment "Shape for airkg:Claim generated from kg/schema.yaml v0.3.2" ;
    sh:property [ sh:maxCount 0 ;
            sh:message "uses_measure is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:uses_measure ],
        [ sh:maxCount 0 ;
            sh:message "recommends is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:recommends ],
        [ sh:maxCount 0 ;
            sh:message "implemented_by is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:implemented_by ],
        [ sh:maxCount 0 ;
            sh:message "operationalizes is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:operationalizes ],
        [ sh:class airkg:Claim ;
            sh:message "Claim -conflicts_with-> must target Claim" ;
            sh:path airkg:conflicts_with ],
        [ sh:maxCount 0 ;
            sh:message "cites is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:cites ],
        [ sh:maxCount 0 ;
            sh:message "builds_on is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:builds_on ],
        [ sh:maxCount 0 ;
            sh:message "measures is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:measures ],
        [ sh:maxCount 0 ;
            sh:message "consumes is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:consumes ],
        [ sh:maxCount 0 ;
            sh:message "has_component is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:has_component ],
        [ sh:maxCount 0 ;
            sh:message "extends is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:extends ],
        [ sh:maxCount 0 ;
            sh:message "applies_to is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:applies_to ],
        [ sh:maxCount 0 ;
            sh:message "grounds is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:grounds ],
        [ sh:message "Claim.evidence_grade is required (schema.yaml required_properties)" ;
            sh:minCount 1 ;
            sh:path airkg:evidence_grade ],
        [ sh:maxCount 0 ;
            sh:message "targets is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:targets ],
        [ sh:maxCount 0 ;
            sh:message "implements is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:implements ],
        [ sh:in ( "peer_reviewed_experiment" "platform_official" "measured_practitioner" "practitioner_assertion" "inference" ) ;
            sh:message "Claim.evidence_grade must be one of the schema enum values" ;
            sh:path airkg:evidence_grade ],
        [ sh:maxCount 0 ;
            sh:message "asserts is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:asserts ],
        [ sh:maxCount 0 ;
            sh:message "mentions is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:mentions ],
        [ sh:maxCount 0 ;
            sh:message "defines is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:defines ],
        [ sh:class airkg:Concept ;
            sh:message "Claim -about-> must target Concept" ;
            sh:path airkg:about ],
        [ sh:maxCount 0 ;
            sh:message "subtype_of is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:subtype_of ],
        [ sh:maxCount 0 ;
            sh:message "supersedes is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:supersedes ],
        [ sh:maxCount 0 ;
            sh:message "precedes is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:precedes ],
        [ sh:in ( "empirical" "normative" "speculative" ) ;
            sh:message "Claim.claim_type must be one of the schema enum values" ;
            sh:path airkg:claim_type ],
        [ sh:maxCount 0 ;
            sh:message "supported_by is not a legal edge out of Claim (schema.yaml pairs)" ;
            sh:path airkg:supported_by ] ;
    sh:targetClass airkg:Claim .

