.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ── Logs / backups ────────────────────────────────────────────────────────
logs/
*.log
*.bak-*

# ── OS / IDE ──────────────────────────────────────────────────────────────
**/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
# crawl4ai web-page markdown captures (cited by URL; content local, provenance in manifest)
corpus/bulk_md/

# T0/T1 substrate (task 2026-08-29_corpus_t0_t1_substrate). All three are REBUILDABLE
# projections, never sources of truth: the db is proven rebuildable by
# `t1_build_index.py --phase rebuild`, the markdown by --phase convert from the admitted
# bytes, and the biblio cache by `python -m kg.biblio resume`. Provenance rides in the
# events and the manifest, not in these files.
state/corpus_index.db
state/corpus_index.rebuild.db
state/docling_md/
state/biblio_cache/
state/convert_errors/

# Round-2 derived layers (task 2026-08-30_acquisition_round2). Same rule: rebuildable
# projections, never sources of truth. `state/refparse/` regenerates with
# `python -m kg.refparse` from state/docling_md; `state/candidate_oa.json` is a provider
# cache that `kg.biblio.enrich_candidates` refills. The DECISIONS they feed are durable —
# they live in corpus/manifest.json, events/batch-020.jsonl and
# docs/corpus/acquisition_candidates.md, all of which are tracked.
state/refparse/
state/candidate_oa.json

# Converted markdown substrate (task 2026-08-31_ingestion_conversion, DD-030). Same rule:
# a rebuildable projection, regenerated by `python -m kg.ingest.gate`. The DURABLE records
# are tracked — the `substrate_converted` / `conversion_gap` events on events/batch-024.jsonl
# and the auto-registered ResearchTasks.
state/substrate_md/

# G1 reviewer-calibration key (sample id -> record). The blind sheet must not be joinable
# to the scorer/reviewer verdicts before the operator has labelled it (task
# 2026-09-03_g1_freeze_calibration_redefinition_findings step 1).
assessment/results/.g1_calibration_key_*.json
