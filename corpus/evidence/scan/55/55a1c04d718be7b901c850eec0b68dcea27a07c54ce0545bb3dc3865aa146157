      "accessLevel": "restricted public",
      "identifier": "3901",
      "publisher": {
        "name": "National Institute of Justice",
        "@type": "org:Organization",
        "subOrganizationOf": {
          "id": 22,
          "acronym": "OJP",
          "name": "Office of Justice Programs",
          "parentOrganizationID": 10,
