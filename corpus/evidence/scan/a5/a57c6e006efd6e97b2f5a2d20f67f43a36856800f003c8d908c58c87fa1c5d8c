  "oid" : 39312130,
  "provenance" : "official",
  "publicationAppendEnabled" : false,
  "publicationDate" : 1676560609,
  "publicationGroup" : 17137785,
  "publicationStage" : "published",
  "queryString" : "SELECT\n  `week`,\n  `level`,\n  `state_fips`,\n  `state_code`,\n  `county_fips`,\n  `county`,\n  date_trunc_y(`date`) AS `date`,\n  avg(`pop_stay_at_home`) AS `pop_stay_at_home`,\n  avg(`pop_not_stay_at_home`) AS `pop_not_stay_at_home`,\n  avg(`trips`) AS `trips`,\n  avg(`trips_1`) AS `trips_1`,\n  avg(`trips_1_3`) AS `trips_1_3`,\n  avg(`trips_3_5`) AS `trips_3_5`,\n  avg(`trips_5_10`) AS `trips_5_10`,\n  avg(`trips_10_25`) AS `trips_10_25`,\n  avg(`trips_25_50`) AS `trips_25_50`,\n  avg(`trips_50_100`) AS `trips_50_100`,\n  avg(`trips_100_250`) AS `trips_100_250`,\n  avg(`trips_250_500`) AS `trips_250_500`,\n  avg(`trips_500`) AS `trips_500`,\n  `month`\nGROUP BY\n  `county`,\n  `county_fips`,\n  `date`,\n  `level`,\n  `month`,\n  `state_code`,\n  `state_fips`,\n  `week`",
