  <script type="application/json" data-drupal-selector="drupal-settings-json">{"path":{"baseUrl":"\/","pathPrefix":"","currentPath":"node\/7112","currentPathIsAdmin":false,"isFront":false,"currentLanguage":"en"},"pluralDelimiter":"\u0003","suppressDeprecationErrors":true,"ers_blocks":{"records":[{"id":"76","title":"Adoption of Genetically Engineered Crops in the United States","slug":"adoption-of-genetically-engineered-crops-in-the-united-states","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-12","url":"\/data-products\/adoption-of-genetically-engineered-crops-in-the-united-states","description":"Data cover genetically engineered (GE) varieties of corn, upland cotton, and soybeans for 2000\u201325, for the United States and States and include the extent of adoption of herbicide-tolerant (HT), insect-resistant (Bt), and both traits (\u0022stacked\u0022) GE crops. A summary reviews trends in GE adoption in the United States.","relatedTopics":"133,115,140,118,177,178,179,126,203","hasInteractiveViz":"0"},{"id":"101","title":"Ag and Food Statistics: Charting the Essentials","slug":"ag-and-food-statistics-charting-the-essentials","type":"Charts","discontinued":"0","lastUpdated":"2026-06-01","url":"\/data-products\/ag-and-food-statistics-charting-the-essentials","description":"A collection of charts and maps presenting key statistics on the farm sector, food spending and prices, food security, rural communities, the interaction of agriculture and natural resources, and more.","relatedTopics":"133,115,138,139,117,150,155,157,172,174,179,188,126","hasInteractiveViz":"0"},{"id":"19","title":"Agricultural and Food Research and Development Expenditures in the United States","slug":"agricultural-and-food-research-and-development-expenditures-in-the-united-states","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-02-13","url":"\/data-products\/agricultural-and-food-research-and-development-expenditures-in-the-united-states","description":"Data for public and private expenditures for agricultural and food research and development (R\u0026D) cover the years 1970-2019 (public) and 1970-2014 (private). Private food industry R\u0026D is also reported for 1970-2019. R\u0026D spending by private agricultural input industries is reported for 1970-2014. Data are shown in current dollars and in constant dollars (adjusted for inflation in the cost of research).","relatedTopics":"133,115,118,126","hasInteractiveViz":"0"},{"id":"57","title":"Agricultural Baseline Database","slug":"agricultural-baseline-database","type":"Queryable Data Applications","discontinued":"0","lastUpdated":"2026-02-13","url":"\/data-products\/agricultural-baseline-database","description":"The Agricultural Baseline Database provides multiple avenues to access to the annual USDA Agricultural Projections report and corresponding data. The long-term agricultural baseline projections indicate the 10-year supply, demand, and trade for major agricultural commodities. The database covers projections for major U.S. field crops (corn, sorghum, barley, oats, wheat, rice, soybeans, and upland cotton), and livestock (beef, pork, poultry and eggs, and dairy) commodities.","relatedTopics":"115,137,116,144,151,119,169,121,183,185,187,190,194,205","hasInteractiveViz":"1"},{"id":"48","title":"Agricultural Exchange Rate Data Set","slug":"agricultural-exchange-rate-data-set","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-27","url":"\/data-products\/agricultural-exchange-rate-data-set","description":"The Agricultural Exchange Rate Data Set contains annual and monthly data for exchange rates important to U.S. agriculture. It includes both nominal and real exchange rates for 79 countries (plus the European Union) as well as real trade-weighted exchange rate indexes for many commodities and aggregations.","relatedTopics":"130,132,137,119,164,170,185,198,201","hasInteractiveViz":"0"},{"id":"64","title":"Agricultural Productivity in the United States","slug":"agricultural-productivity-in-the-united-states","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-07-20","url":"\/data-products\/agricultural-productivity-in-the-united-states","description":"Estimates of productivity growth in the U.S. farm sector for 1948\u20132023, and estimates of the growth\/relative levels of productivity across States for 1960\u20132015.","relatedTopics":"133,115,139,140,141,118,177,196,126,207","hasInteractiveViz":"0"},{"id":"88","title":"Agricultural Trade Multipliers","slug":"agricultural-trade-multipliers","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-07-02","url":"\/data-products\/agricultural-trade-multipliers","description":"The Agricultural Trade Multipliers (ATM) data product provides annual estimates of employment and output effects of trade in farm and food products on the U.S. economy. When expressed as multipliers, these effects reflect the amount of economic activity and jobs supported by agricultural exports.","relatedTopics":"119","hasInteractiveViz":"0"},{"id":"60","title":"Aquaculture Data","slug":"aquaculture-data","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-07","url":"\/data-products\/aquaculture-data","description":"Statistics on domestically grown catfish and trout and U.S. imports and exports of fish and shellfish that may be products of aquaculture, such as salmon, shrimp, and oysters.","relatedTopics":"148,121","hasInteractiveViz":"0"},{"id":"92","title":"Area and Road Ruggedness Scales","slug":"area-and-road-ruggedness-scales","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-09-04","url":"\/data-products\/area-and-road-ruggedness-scales","description":"The Area and Road Ruggedness Scales data product provides measures of topographic variation for census tracts across 50 States and Washington, DC. This data product provides both continuous and categorical measures of topographic variation, offering users the flexibility to utilize measures of rugged terrain that meet their unique needs. The data include the Area Ruggedness Scale, a six-category measure based on the changes in elevation for all terrain, and the Road Ruggedness Scale, a five-category measure based on the changes in elevation beneath roads. The data are available for vintage 2010 and 2020 census tracts.","relatedTopics":"115,143,117,150,152,155,157,174,179,181,196,126","hasInteractiveViz":"0"},{"id":"24","title":"ARMS Farm Financial and Crop Production Practices","slug":"arms-farm-financial-and-crop-production-practices","type":"Queryable Data Applications","discontinued":"0","lastUpdated":"2026-03-20","url":"\/data-products\/arms-farm-financial-and-crop-production-practices","description":"USDA\u0027s Agricultural Resource Management Survey (ARMS) is the primary source of information on the financial condition, production practices, resource use, and economic well-being of farm households.","relatedTopics":"133,115,139,140,141,118,149,157,172,177,179,188,196,126,199,203,207","hasInteractiveViz":"1"},{"id":"96","title":"Atlas of Rural and Small-Town America","slug":"atlas-of-rural-and-small-town-america","type":"Maps","discontinued":"0","lastUpdated":"2025-09-23","url":"\/data-products\/atlas-of-rural-and-small-town-america","description":"View the diversity of challenges and opportunities across America\u0027s counties. View indicators about people, jobs, income, veterans, and county types. The atlas has been updated to include annual unemployment\/employment estimates for 2021; earlier estimates were revised. County population estimates for July 1, 2021 were added and maps using data from the 2010 Decennial Census were replaced with data from the 2020 Decennial Census. Maps using data from the American Community Survey (ACS) were updated to 2017\u201321 (5-year average county-level data).","relatedTopics":"115,143,117,150,152,155,174,181,199","hasInteractiveViz":"0"},{"id":"77","title":"Best of Charts of Note 2013","slug":"best-of-charts-of-note-2013","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/best-of-charts-of-note-2013","description":"This collection highlights the best from the 2013 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"41","title":"Best of Charts of Note 2014","slug":"best-of-charts-of-note-2014","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/best-of-charts-of-note-2014","description":"This collection highlights the best from the 2014 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"95","title":"Best of Charts of Note 2015","slug":"best-of-charts-of-note-2015","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/best-of-charts-of-note-2015","description":"This collection highlights the best from the 2015 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"104","title":"Best of Charts of Note 2016","slug":"best-of-charts-of-note-2016","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/best-of-charts-of-note-2016","description":"This collection highlights the best from the 2016 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"46","title":"Best of Charts of Note 2017","slug":"best-of-charts-of-note-2017","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/best-of-charts-of-note-2017","description":"This collection highlights the best from the 2017 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"45","title":"Chart Gallery","slug":"chart-gallery","type":"Charts","discontinued":"0","lastUpdated":"2025-01-05","url":"\/data-products\/chart-gallery","description":"A collection of charts from the ERS website.","relatedTopics":"138","hasInteractiveViz":"0"},{"id":"79","title":"Charts of Note","slug":"charts-of-note","type":"Charts","discontinued":"0","lastUpdated":"2025-09-05","url":"\/data-products\/charts-of-note","description":"Charts of Note from ERS are distributed Tuesday\u2013Friday by the Economic Research Service to highlight charts of interest from our current and past research.","relatedTopics":"138","hasInteractiveViz":"0"},{"id":"12","title":"China Agricultural and Economic Data","slug":"china-agricultural-and-economic-data","type":"Queryable Data Applications","discontinued":"1","lastUpdated":"2025-03-26","url":"\/data-products\/china-agricultural-and-economic-data","description":"This database is no longer being updated. The China agricultural and economic database is a collection of agricultural-related data from official statistical publications of the People\u0027s Republic of China. Analysts and policy professionals around the world need information about the rapidly changing Chinese economy, but statistics are often published only in China and sometimes only in Chinese-language publications. This product assembles a wide variety of data items covering agricultural production, inputs, prices, food consumption, output of industrial products relevant to the agricultural sector, and macroeconomic data. ","relatedTopics":"137","hasInteractiveViz":"0"},{"id":"37","title":"Commodity and Food Elasticities","slug":"commodity-and-food-elasticities","type":"Queryable Data Applications","discontinued":"1","lastUpdated":"2025-01-03","url":"\/data-products\/commodity-and-food-elasticities","description":"This database is no longer being updated. The Commodity and Food Elasticities Database is a collection of elasticities from research on consumer demand published in working papers, dissertations, and peer-reviewed journals and as presented at professional conferences in the United States. Most of the literature is from U.S. academic and government research. The database allows queriable searches of income, expenditure, and own- and cross-price elasticities for specific commodities and countries, which can be ranked and sorted. The most fully covered countries are the United States and China, and the greatest number of demand studies are for vegetables, fruits, and grocery products such as coffee and ketchup. ","relatedTopics":"115,119,169,121,184,205","hasInteractiveViz":"0"},{"id":"73","title":"Commodity Consumption by Population Characteristics","slug":"commodity-consumption-by-population-characteristics","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2026-06-25","url":"\/data-products\/commodity-consumption-by-population-characteristics","description":"Note: Updates to this data product are discontinued. ERS tracks the supply of food available for consumption in the United States and examines consumer food preferences by consumers\u2019 age, income, region, race\/ethnicity, and place where food is obtained, as well as by food\/commodity categories and other characteristics.","relatedTopics":"131,171","hasInteractiveViz":"0"},{"id":"59","title":"Commodity Costs and Returns","slug":"commodity-costs-and-returns","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-06-18","url":"\/data-products\/commodity-costs-and-returns","description":"USDA has estimated annual production costs and returns and published accounts for major field crop and livestock enterprises since 1975. Cost and return estimates are reported for the United States and major production regions for corn, soybeans, wheat, cotton, grain sorghum, rice, peanuts, oats, barley, milk, hogs, and cow-calf. These cost and return accounts are \u0022historical\u0022 accounts based on the actual costs incurred by producers.","relatedTopics":"137,139,116,140,141,118,144,159,121,172,173,177,190,191,194,195,126,203,205","hasInteractiveViz":"1"},{"id":"49","title":"Commuting Zones and Labor Market Areas","slug":"commuting-zones-and-labor-market-areas","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-01-09","url":"\/data-products\/commuting-zones-and-labor-market-areas","description":"The Commuting Zones data product groups counties into geographic units of analysis that more closely reflect the labor markets where people live and work than governmental boundaries often do. They use county-to-county commuting flows to identify where residents of rural counties are likely to travel for work, allowing users to examine the variation in socioeconomic conditions across labor markets. The 2020 Commuting Zones are available for the United States and Puerto Rico.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"89","title":"Cost Estimates of Foodborne Illnesses","slug":"cost-estimates-of-foodborne-illnesses","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-06-16","url":"\/data-products\/cost-estimates-of-foodborne-illnesses","description":"The Cost Estimates of Foodborne Illnesses data product provides estimates of the cost of foodborne illnesses in the United States. Total and per-case costs are provided for foodborne illness as a whole, and for individual pathogens.","relatedTopics":"128,135,119,180,123,124","hasInteractiveViz":"0"},{"id":"78","title":"Cotton, Wool, and Textile Data","slug":"cotton-wool-and-textile-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-01-08","url":"\/data-products\/cotton-wool-and-textile-data","description":"This data product contains data on U.S. cotton and wool supply, demand, and prices, as well as U.S. cotton and textile trade data, maintained by the Economic Research Service to support related commodity market analysis and research.","relatedTopics":"137,119,159,178,201,116","hasInteractiveViz":"0"},{"id":"91","title":"County Typology Codes","slug":"county-typology-codes","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-31","url":"\/data-products\/county-typology-codes","description":"The 2025 edition of the USDA, Economic Research Service, County Typology Codes classifies all U.S. counties into six economic types and six demographic types. The economic types identify counties that have a high concentration of earnings and\/or employment in farming, mining, manufacturing, Federal\/and State Government, recreation, or are unspecialized. The demographic types identify counties that have low post-secondary education, low employment, population loss, housing stress, are retirement destinations, and\/or have persistent poverty.","relatedTopics":"143,117,150,152,155,174,181","hasInteractiveViz":"0"},{"id":"38","title":"County-level Data Sets","slug":"county-level-data-sets","type":"Queryable Data Applications","discontinued":"0","lastUpdated":"2025-01-31","url":"\/data-products\/county-level-data-sets","description":"County level population change, poverty rates, educational attainment, and unemployment rates\/median household income.","relatedTopics":"117,150,155,174","hasInteractiveViz":"0"},{"id":"55","title":"County-level Oil and Gas Production in the United States","slug":"county-level-oil-and-gas-production-in-the-united-states","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-12-30","url":"\/data-products\/county-level-oil-and-gas-production-in-the-united-states","description":"Note: Updates to this data product are discontinued. County-level data from oil and\/or natural gas producing States\u2014for onshore production in the lower 48 States\u2014available annually, 2000-11.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"25","title":"Creative Class County Codes","slug":"creative-class-county-codes","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-12-30","url":"\/data-products\/creative-class-county-codes","description":"Note: Updates to this data product are discontinued. The creative class thesis\u2014that towns need to attract engineers, architects, artists, and people in other creative occupations to compete in today\u0027s economy\u2014may be particularly relevant to rural communities, which tend to lose much of their talent when young adults leave. The ERS creative class codes indicate a county\u0027s share of population employed in occupations that require \u0022thinking creatively.\u0022 Variables used to construct the ERS creative class measure include number and percent employed in creative class occupations and a metro\/nonmetro indicator for all counties, 1990, 2000, and 2007-11. A break-out of employment in the arts is included.","relatedTopics":"143,117,181","hasInteractiveViz":"0"},{"id":"42","title":"Dairy Data","slug":"dairy-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-27","url":"\/data-products\/dairy-data","description":"The dairy data files cover U.S. supply, demand, and trade for milk and major dairy products.","relatedTopics":"159,121,187,205","hasInteractiveViz":"0"},{"id":"80","title":"Data Visualizations","slug":"data-visualizations","type":"Charts","discontinued":"0","lastUpdated":"2025-08-08","url":"\/data-products\/data-visualizations","description":"A collection of ERS interactive data visualizations hosted on Tableau Public.","relatedTopics":"138","hasInteractiveViz":"0"},{"id":"32","title":"Eating and Health Module (ATUS)","slug":"eating-and-health-module-atus","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-01-05","url":"\/data-products\/eating-and-health-module-atus","description":"2023 data are now available from the 2022\u20132023 Eating and Health Module (EHM), a supplement to the American Time Use Survey. The EHM asked respondents about secondary eating (eating while doing another activity); grocery shopping preferences and fast food purchases; meal preparation; food and nutrition assistance participation; general health, height and weight, and exercise; and income. Understanding time use patterns can provide insight into economic behaviors associated with eating patterns as well as the diet and health status of individuals.","relatedTopics":"136,147,120,167,171,125,206","hasInteractiveViz":"0"},{"id":"93","title":"Editors\u0027 Pick Charts of Note 2018","slug":"editors-pick-charts-of-note-2018","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/editors-pick-charts-of-note-2018","description":"This collection highlights the best from the 2018 Charts of Note offering.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"97","title":"Editors\u0027 Pick: Charts of Note 2019","slug":"editors-pick-charts-of-note-2019","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/editors-pick-charts-of-note-2019","description":"This chart gallery is a collection of some of the best Charts of Note from 2019.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"52","title":"Editors\u0027 Pick: Charts of Note 2020","slug":"editors-pick-charts-of-note-2020","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/editors-pick-charts-of-note-2020","description":"This chart gallery is a collection of some of the best Charts of Note from 2020.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"61","title":"Farm Household Income and Characteristics","slug":"farm-household-income-and-characteristics","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-09-03","url":"\/data-products\/farm-household-income-and-characteristics","description":"This data product presents the latest household income forecast and financial and socioeconomic indicators for principal operators of U.S. family farms, including health insurance coverage\/expenditures of farm operator households.","relatedTopics":"115,139,149,172,188,199","hasInteractiveViz":"0"},{"id":"35","title":"Farm Income and Wealth Statistics","slug":"farm-income-and-wealth-statistics","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-09-03","url":"\/data-products\/farm-income-and-wealth-statistics","description":"Estimates and forecasts of farm sector income with component accounts for the United States.","relatedTopics":"115,139,149,172,179,187,188,199,207","hasInteractiveViz":"1"},{"id":"99","title":"Federal Funds","slug":"federal-funds","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-05","url":"\/data-products\/federal-funds","description":"Note: Updates to this data product are discontinued. The underlying data are no longer available. ERS screened data from the Census Bureau\u0027s Consolidated Federal Funds Reports for each Federal program for accuracy at the county level and then presents the data by function and type of program for each county and State.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"50","title":"Feed Grains Database","slug":"feed-grains-database","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-05-07","url":"\/data-products\/feed-grains-database","description":"The Feed Grains Database contains statistics on four feed grains (corn, grain sorghum, barley, and oats), foreign coarse grains (feed grains plus rye, millet, and mixed grains), hay, and related items.","relatedTopics":"115,116,144,158,160,168,121,183,187,195,205","hasInteractiveViz":"0"},{"id":"69","title":"Fertilizer Imports\/Exports","slug":"fertilizer-imports-exports","type":"Queryable Data Applications","discontinued":"1","lastUpdated":"2025-12-31","url":"\/data-products\/fertilizer-imports-exports","description":"Note: Updates to this data product are discontinued. The underlying information is available from the U.S. Department of Commerce, Foreign Trade Division. This product provides U.S. annual data on imports and exports of selected fertilizer types. The data cover imports from 1995 to 2012 and exports from 1990 to 2012 for 26 major fertilizer products an materials, and for 82 major trading countries.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"87","title":"Fertilizer Use and Price","slug":"fertilizer-use-and-price","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-30","url":"\/data-products\/fertilizer-use-and-price","description":"This product summarizes fertilizer consumption in the United States by plant nutrient and major fertilizer products\u2014as well as consumption of mixed fertilizers, secondary nutrients, and micronutrients\u2014for 1960 through the latest year for which statistics are available. The share of planted crop acreage receiving fertilizer, and fertilizer applications per receiving acre (by nutrient), are presented for major producing States for corn, cotton, soybeans, and wheat (nutrient consumption by crop data starts in 1964). Fertilizer farm prices and indices of wholesale fertilizer prices are also available.","relatedTopics":"140,141,118,144,126","hasInteractiveViz":"0"},{"id":"21","title":"Food Access Research Atlas","slug":"food-access-research-atlas","type":"Maps","discontinued":"0","lastUpdated":"2026-08-19","url":"\/data-products\/food-access-research-atlas","description":"The Food Access Research Atlas (FARA) provides two interactive mapping applications, the newly created SNAP-authorized Retailer Access Map and the Large Retailer Access Map (renamed from FARA), to show food access indicators at the U.S. census tract level. Users can view food access measures and download data.","relatedTopics":"136,153,162,163,167,171,189,124,125,204","hasInteractiveViz":"1"},{"id":"31","title":"Food and Nutrition Assistance Research Reports Database","slug":"food-and-nutrition-assistance-research-reports-database","type":"Queryable Data Applications","discontinued":"1","lastUpdated":"2026-06-25","url":"\/data-products\/food-and-nutrition-assistance-research-reports-database","description":"Note: Updates to this data product are discontinued. ERS supports a broad spectrum of food and nutrition assistance research and has compiled an electronic database of more than 1,100 peer-reviewed reports and articles based on ERS-supported research. The database is searchable by title, lead author, topic, year of publication, and data set analyzed.","relatedTopics":"153,156,166,167,171,189,125,206","hasInteractiveViz":"0"},{"id":"44","title":"Food Availability (Per Capita) Data System","slug":"food-availability-per-capita-data-system","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-06-26","url":"\/data-products\/food-availability-per-capita-data-system","description":"The ERS Food Availability (Per Capita) Data System (FADS) includes two data series on food available for consumption in the United States: food availability data and loss-adjusted food availability data.","relatedTopics":"131,135,136,145,147,120,124","hasInteractiveViz":"0"},{"id":"67","title":"Food Consumption, Nutrient Intakes, and Diet Quality","slug":"food-consumption-nutrient-intakes-and-diet-quality","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-06-10","url":"\/data-products\/food-consumption-nutrient-intakes-and-diet-quality","description":"Nutrient and food consumption in terms of Federal dietary guidance is reported for all sources and the total U.S. population, as well as by food source, age group, sex, race and ethnicity, adult education attainment, and household income demographics. Data are divided into two main categories\u2014food at home and food away from home, with food-away-from-home data available for restaurants, fast-food places, schools, and other food-away-from-home places.","relatedTopics":"131,136,147,120,171","hasInteractiveViz":"0"},{"id":"75","title":"Food Dollar","slug":"food-dollar","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-05-11","url":"\/data-products\/food-dollar","description":"The Food Dollar measures the costs of food production for supply chains that make up domestic food spending by attributing the value added along parts of the supply chain, such as farm establishments, food processing, and food services.","relatedTopics":"135,142,145,165,124","hasInteractiveViz":"0"},{"id":"14","title":"Food Environment Atlas","slug":"food-environment-atlas","type":"Maps","discontinued":"0","lastUpdated":"2026-08-12","url":"\/data-products\/food-environment-atlas","description":"The Food Environment Atlas is a web-based mapping tool developed by ERS to compare U.S. counties by \u201cfood environment\u201d indicators\u2014such as store\/restaurant proximity, availability of local foods, food and nutrition assistance programs, and community characteristics\u2014which interact to impact food choices and diet quality.","relatedTopics":"131,136,142,145,147,120,153,156,162,163,165,166,167,171,184,189,124,125,204,206","hasInteractiveViz":"0"},{"id":"98","title":"Food Expenditure Series","slug":"food-expenditure-series","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-19","url":"\/data-products\/food-expenditure-series","description":"The Food Expenditure Series measures the value of food acquired in the United States by type of product, outlet, and purchaser. National estimates are available monthly and annually, while State-level estimates are available annually.","relatedTopics":"131,135,142,145,147,162,163,165,124,204","hasInteractiveViz":"1"},{"id":"86","title":"Food Price Outlook","slug":"food-price-outlook","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-31","url":"\/data-products\/food-price-outlook","description":"The Food Price Outlook provides food price data and forecasts changes in the Consumer Price Index (CPI) and Producer Price Index (PPI) for food.","relatedTopics":"131,135,142,162,124","hasInteractiveViz":"1"},{"id":"103","title":"Food Security in the United States","slug":"food-security-in-the-united-states","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-07-28","url":"\/data-products\/food-security-in-the-united-states","description":"This product provides information about publicly available data from national surveys that include the U.S. Food Security Survey Module. Technical information and questionnaires are provided for the Current Population Survey Food Security Supplement  (CPS-FSS) to facilitate appropriate use of the data. Information about where to access CPS-FSS data is also provided.","relatedTopics":"117,119,153,156,167,174,189,125,206","hasInteractiveViz":"0"},{"id":"53","title":"Food-at-Home Monthly Area Prices","slug":"food-at-home-monthly-area-prices","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-04-10","url":"\/data-products\/food-at-home-monthly-area-prices","description":"The Food-at-Home Monthly Area Prices (F-MAP) product provides retail food price data over time and across areas. The F-MAP includes monthly average unit prices and price indexes for 90 food groups across 15 geographic areas. The food groups in the F-MAP are based on the ERS Food Purchase Groups (EFPGs), a system for classifying foods based on characteristics such as ingredients, nutritional content, and convenience level.  ","relatedTopics":"131,135,142,124","hasInteractiveViz":"0"},{"id":"36","title":"FoodAPS National Household Food Acquisition and Purchase Survey","slug":"foodaps-national-household-food-acquisition-and-purchase-survey","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-01-12","url":"\/data-products\/foodaps-national-household-food-acquisition-and-purchase-survey","description":"USDA\u0027s National Household Food Acquisition and Purchase Survey (FoodAPS) is a detailed nationally representative survey of household food purchases and acquisitions.","relatedTopics":"131,136,142,145,147,120,153,162,163,166,189,124,125","hasInteractiveViz":"1"},{"id":"13","title":"Foreign Agricultural Trade of the United States (FATUS)","slug":"foreign-agricultural-trade-of-the-united-states-fatus","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-07-08","url":"\/data-products\/foreign-agricultural-trade-of-the-united-states-fatus","description":"The Foreign Agricultural Trade of the United States (FATUS) data page provides U.S. agricultural exports and imports, volume and value, by country and by commodity. Updated monthly or annually.","relatedTopics":"151,119,158,160,168,121,178,182,191,195,201,205,116","hasInteractiveViz":"0"},{"id":"16","title":"Frontier and Remote Area Codes","slug":"frontier-and-remote-area-codes","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-03-13","url":"\/data-products\/frontier-and-remote-area-codes","description":"The 2020 Frontier and Remote Area (FAR) codes provide a statistically-based, nationally-consistent, and adjustable definition of territory in the U.S. characterized by low population density and high geographic remoteness. ","relatedTopics":"117,152","hasInteractiveViz":"0"},{"id":"18","title":"Fruit and Tree Nuts Data","slug":"fruit-and-tree-nuts-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-09-22","url":"\/data-products\/fruit-and-tree-nuts-data","description":"This data product provides users with comprehensive statistics on fresh and processed fruit and tree nuts in the United States, as well as global production and trade data for these sectors. It harmonizes and integrates data from the ERS market outlook program with data collected by different Federal and international statistical agencies to facilitate analyses of economic performance over time, and across domestic and foreign markets. Data are provided for more than 30 individual fresh and processed products. ","relatedTopics":"175,184,116","hasInteractiveViz":"0"},{"id":"63","title":"Fruit and Vegetable Prices","slug":"fruit-and-vegetable-prices","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-09","url":"\/data-products\/fruit-and-vegetable-prices","description":"Fruit and Vegetables Prices reports estimated average prices for over 150 commonly consumed fresh and processed fruits and vegetables, including each product\u0027s average retail price per pound and per edible cup equivalent (the unit of measurement for Federal recommendations for fruit and vegetable consumption).","relatedTopics":"135,142,145,162,165,175,184,124,204,116","hasInteractiveViz":"1"},{"id":"74","title":"Global Food Assessment","slug":"global-food-assessment","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-26","url":"\/data-products\/global-food-assessment","description":"The dataset from the Global Food Assessment report contains regional and subregional level data on grain food demand, other demand (including seed, feed, and other uses), total demand, production, and the implied additional supply required. The implied additional supply required quantifies the grain demand in each region and subregion that is not projected to be met through domestic production. ","relatedTopics":"130,132,119,164,170,182,192,198","hasInteractiveViz":"0"},{"id":"11","title":"International Agricultural Productivity","slug":"international-agricultural-productivity","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-01-27","url":"\/data-products\/international-agricultural-productivity","description":"This data product provides agricultural output, inputs, and total factor productivity (TFP) indices across the countries and regions of the world in a consistent, comparable way.","relatedTopics":"130,132,133,115,140,141,118,119,164,170,177,182,196,198","hasInteractiveViz":"0"},{"id":"81","title":"International Baseline Data","slug":"international-baseline-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-02-10","url":"\/data-products\/international-baseline-data","description":"The USDA, Economic Research Service\u0027s International Baseline Data webpages provide multiple resources enabling users to navigate the 10-year international agricultural projections, which are developed by the USDA, Interagency Agricultural Projections Committee. International baseline projections indicate long-run supply, demand, and trade for major agricultural commodities and major exporting and importing countries and regions. The projections provide foreign country detail supporting the annual USDA Agricultural Projections report, published in February.","relatedTopics":"127,130,115,119,158,160,168,121,178,185,194,201,205,116","hasInteractiveViz":"1"},{"id":"265","title":"International Food and Alcoholic Beverage Expenditure Data","slug":"international-food-and-alcoholic-beverage-expenditure-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-11","url":"\/data-products\/international-food-and-alcoholic-beverage-expenditure-data","description":"The tables contain data on food expenditures (including nonalcoholic beverages), alcoholic beverages, and tobacco as a share of consumer expenditures on all goods and services for 103-104 countries. The tables also contain data on per capita consumer expenditures on goods and services, as well as per capita food expenditures for these countries. All expenditure data are in current U.S. dollars.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"56","title":"International Food Consumption Patterns","slug":"international-food-consumption-patterns","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-12-31","url":"\/data-products\/international-food-consumption-patterns","description":"This database is no longer being updated. Total and marginal budget shares and income and price elasticities are estimated, using 2005 ICP data, for nine broad consumption groups and eight food subgroups across 144 countries.","relatedTopics":"130,132,115,151,119,164,169,170,182,198,201","hasInteractiveViz":"0"},{"id":"39","title":"International Macroeconomic Data Set","slug":"international-macroeconomic-data-set","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-05-27","url":"\/data-products\/international-macroeconomic-data-set","description":"The International Macroeconomic Data Set provides historical and projected data for real (adjusted for inflation) gross domestic product (GDP), population, real exchange rates, and other variables for the 181 countries and 34 regions that are most important for U.S. agricultural trade.","relatedTopics":"127,130,132,115,119,164,169,170,182,185,198,201","hasInteractiveViz":"0"},{"id":"68","title":"Irrigated Agriculture in the United States","slug":"irrigated-agriculture-in-the-united-states","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-05","url":"\/data-products\/irrigated-agriculture-in-the-united-states","description":"Note: Updates to this data product are discontinued. This data product summarizes irrigated farms in the United States based on USDA\u0027s 2013 Farm and Ranch Irrigation Survey (FRIS). A previous release of this data product\u2014which summarized the farm-structural characteristics for irrigated farms in the 17 Western States based on USDA\u0027s 2008 and 1998 Farm and Ranch Irrigation Surveys\u2014is available in a zipped archive file.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"28","title":"Livestock and Meat Domestic Data","slug":"livestock-and-meat-domestic-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-27","url":"\/data-products\/livestock-and-meat-domestic-data","description":"The Livestock \u0026 Meat Domestic Data contains current and historical data on pork, beef, veal, and poultry, including production, supply, utilization, and farm prices.","relatedTopics":"158,160,168,121,187,195,205","hasInteractiveViz":"0"},{"id":"84","title":"Livestock and Meat International Trade Data","slug":"livestock-and-meat-international-trade-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-09-04","url":"\/data-products\/livestock-and-meat-international-trade-data","description":"The Livestock and Meat International Trade data set contains monthly and annual data for imports and exports of live cattle, hogs, sheep, and goats, as well as beef and veal, pork, lamb and mutton, chicken meat, turkey meat, and eggs.","relatedTopics":"127,158,160,168,121,195,202,205","hasInteractiveViz":"0"},{"id":"40","title":"Major Land Uses","slug":"major-land-uses","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-14","url":"\/data-products\/major-land-uses","description":"The Major Land Uses (MLU) series contains acreage estimates of major uses for the U.S., regions, and States, beginning in 1945 and published about every 5 years since. The MLU series is the longest running, most comprehensive accounting of all major uses of public and private land in the United States. The annual cropland summary table has been consistently maintained since 1910.","relatedTopics":"140,118,157,179,196,126","hasInteractiveViz":"0"},{"id":"17","title":"Meat Price Spreads","slug":"meat-price-spreads","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-12","url":"\/data-products\/meat-price-spreads","description":"This data set provides monthly average price values, and the differences among those values, at the farm, wholesale, and retail stages of the production and marketing chain for selected cuts of beef, pork, and broilers.","relatedTopics":"158,160,168,121,195,205","hasInteractiveViz":"0"},{"id":"82","title":"Milk Cost of Production Estimates","slug":"milk-cost-of-production-estimates","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-05-01","url":"\/data-products\/milk-cost-of-production-estimates","description":"Monthly national milk cost of production estimates for 2005-2017, and annual milk cost of production estimates by state and by size of operation for 2005-present.","relatedTopics":"137,121,172,187,205","hasInteractiveViz":"0"},{"id":"66","title":"Natural Amenities Scale","slug":"natural-amenities-scale","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-31","url":"\/data-products\/natural-amenities-scale","description":"The natural amenities scale county-based measure of the physical characteristics of an area that enhance the location as a place to live. The scale was constructed by combining six measures of climate, topography, and water area that reflect environmental qualities most people prefer. ","relatedTopics":"143,117,150,179,181","hasInteractiveViz":"0"},{"id":"20","title":"Normalized Prices","slug":"normalized-prices","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-31","url":"\/data-products\/normalized-prices","description":"Each year, ERS calculates \u0022normalized prices,\u0022 which smooth out the effects of shortrun seasonal or cyclical variation, for key agricultural inputs and outputs. These prices are used to assist in evaluating the benefits and costs of projects affecting agriculture.","relatedTopics":"118,126","hasInteractiveViz":"0"},{"id":"102","title":"Oil Crops Yearbook","slug":"oil-crops-yearbook","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-03-23","url":"\/data-products\/oil-crops-yearbook","description":"Oilseed, oilmeal, and fats and oils supply and use statistics. Includes oilseed acreage, yield, and production estimates and farm and wholesale price series. ","relatedTopics":"191,116","hasInteractiveViz":"0"},{"id":"26","title":"Organic Handlers: Procurement and Contracting","slug":"organic-handlers-procurement-and-contracting","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2026-01-26","url":"\/data-products\/organic-handlers-procurement-and-contracting","description":"Note: Updates to this data product are discontinued. This product provides results from the 2004 and 2007 Nationwide Surveys of Organic Manufacturers, Processors, and Distributors. Data are available on 9 commodity groups, such as fruit and nuts, and 45 commodities, such as berries and citrus.","relatedTopics":"203","hasInteractiveViz":"0"},{"id":"54","title":"Organic Prices","slug":"organic-prices","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2026-01-26","url":"\/data-products\/organic-prices","description":"Note: Updates to this data product are discontinued. Wholesale prices for select organic and conventional fruits and vegetables, first receiver prices for organic poultry and eggs, and f.o.b. and spot market prices for organic grain and feedstuffs. Estimated U.S. sales volume of organic and total fluid milk, based on Federal milk marketing order statistics. All data are now through 2013.","relatedTopics":"203","hasInteractiveViz":"0"},{"id":"71","title":"Organic Production","slug":"organic-production","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2026-01-26","url":"\/data-products\/organic-production","description":"Note: Updates to this data product are discontinued. ERS collects data from USDA-accredited State and private certification groups to calculate the extent of certified organic farmland acreage and livestock in the United States.","relatedTopics":"140,141,203","hasInteractiveViz":"0"},{"id":"105","title":"Phytosanitary Regulation","slug":"phytosanitary-regulation","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/phytosanitary-regulation","description":"NOTE: This data product is no longer being updated. This data product identified which countries, under APHIS phytosanitary rules, were eligible to export to the United States the fresh fruits and vegetables that were most important in the American diet.","relatedTopics":"119,175,184,201","hasInteractiveViz":"0"},{"id":"90","title":"Population-Interaction Zones for Agriculture (PIZA)","slug":"population-interaction-zones-for-agriculture-piza","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-05","url":"\/data-products\/population-interaction-zones-for-agriculture-piza","description":"Note: Updates to this data product are discontinued. The PIZA codes index small geographic areas (the contiguous 48 States divided up into five-kilometer grid cells) according to the size and proximity of population concentrations.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"29","title":"Poverty Area Measures","slug":"poverty-area-measures","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-03-18","url":"\/data-products\/poverty-area-measures","description":"This data product provides poverty area measures for counties and census tracts across the 50 States and Washington DC. The measures include indicators of high poverty areas, extreme poverty areas, persistent poverty areas, and enduring poverty areas for Decennial Census years 1960\u20132000 and for American Community Survey (ACS) 5-year periods spanning 2007\u201311, 2017\u201321, 2018-22 and 2019-23.","relatedTopics":"143,117,150,152,155,174,181","hasInteractiveViz":"0"},{"id":"100","title":"Price Spreads from Farm to Consumer","slug":"price-spreads-from-farm-to-consumer","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-12","url":"\/data-products\/price-spreads-from-farm-to-consumer","description":"ERS compares the prices paid by consumers for food with the prices received by farmers for their corresponding commodities. These comparisons are reported for a variety of foods sold in retail food stores. ","relatedTopics":"135,142,145,162,165,124","hasInteractiveViz":"0"},{"id":"33","title":"Purchase to Plate","slug":"purchase-to-plate","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-07-23","url":"\/data-products\/purchase-to-plate","description":"The Purchase to Plate Suite (PP-Suite) is a set of data products developed by linking household and retail grocery scanner data with the USDA nutrition databases. The National Average Prices data allow users to import price estimates for foods found in USDA dietary survey data. Restricted access elements of the Purchase to Plate Suite include the Crosswalk, Price Tool, and Ingredient Tool.","relatedTopics":"131,136,142,120,162,166,124,125","hasInteractiveViz":"0"},{"id":"30","title":"Quarterly Food-Away-From-Home Prices","slug":"quarterly-food-away-from-home-prices","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2026-06-25","url":"\/data-products\/quarterly-food-away-from-home-prices","description":"Note: Updates to this data product are discontinued. The Quarterly Food-Away-From-Home Prices (QFAFHP) data set provides quarterly price data for food away from home and alcohol, both at home and away from home, to support research on the economic determinants of diet quality and health outcomes. ","relatedTopics":"131,136,145,162,163,165,171,124,204","hasInteractiveViz":"0"},{"id":"264","title":"Resource Requirements of Food Demand","slug":"resource-requirements-of-food-demand","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-06-11","url":"\/data-products\/resource-requirements-of-food-demand","description":"The Resource Requirements of Food Demand (RRFD) data product measures the U.S. food system\u2019s annual use of employment, energy, and water by supply chain stages, food and beverage categories, and marketing channels.","relatedTopics":"207,196,131,142,145,165,162,185,124,118,115,126,120","hasInteractiveViz":"1"},{"id":"65","title":"Rice Yearbook","slug":"rice-yearbook","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-03-26","url":"\/data-products\/rice-yearbook","description":"U.S. rice production, supply, disappearance, trade, and price data. Includes state acreage, yield, and production data; U.S. and world price series; and program statistics. Contains world supply and use estimates as well. ","relatedTopics":"190,116","hasInteractiveViz":"0"},{"id":"85","title":"Rural Child Poverty Chart Gallery","slug":"rural-child-poverty-chart-gallery","type":"Charts","discontinued":"1","lastUpdated":"2025-01-04","url":"\/data-products\/rural-child-poverty-chart-gallery","description":"Note: Updates to this data product are discontinued. Factors that shape the geography of high and increasing rural child poverty are explored: economic conditions, young adult education levels, and family structure.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"94","title":"Rural Definitions","slug":"rural-definitions","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-01-05","url":"\/data-products\/rural-definitions","description":"Note: Updates to this data product are discontinued. Dozens of definitions are currently used by Federal and State agencies, researchers, and policymakers. The ERS Rural Definitions data product allows users to make comparisons among nine representative rural definitions.","relatedTopics":"","hasInteractiveViz":"0"},{"id":"83","title":"Rural-Urban Commuting Area Codes","slug":"rural-urban-commuting-area-codes","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-09","url":"\/data-products\/rural-urban-commuting-area-codes","description":"The Rural-Urban Commuting Area (RUCA) codes are a classification scheme allowing for flexible, census tract delineation of rural and urban areas. They use measures of urbanization, population, and commuting to create a set of primary and secondary codes that establish urban cores and the census tracts that are the most economically integrated with those cores. The 2020 RUCA codes are available for census tracts and ZIP codes throughout the United States and its territories.","relatedTopics":"117,150,152,181","hasInteractiveViz":"0"},{"id":"22","title":"Rural-Urban Continuum Codes","slug":"rural-urban-continuum-codes","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-12-30","url":"\/data-products\/rural-urban-continuum-codes","description":"The 2023 Rural-Urban Continuum Codes distinguish U.S. metropolitan (metro) counties by the population size of their metro area, and nonmetropolitan (nonmetro) counties by their degree of urbanization and adjacency to a metro area. The division of counties as either metro or nonmetro, based on the 2023 Office of Management and Budget (OMB) delineation of metro areas, is further subdivided into three metro and six nonmetro categories. Each county and census-designated county-equivalent in the United States, including those in outlying territories, is assigned one of these nine codes. The codes allow researchers, policy makers, and others to view county-level data by finer residential groups\u2014beyond metro and nonmetro\u2014when analyzing trends related to population density and metro influence.","relatedTopics":"117,150,152","hasInteractiveViz":"0"},{"id":"27","title":"Season-Average Price Forecasts","slug":"season-average-price-forecasts","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-13","url":"\/data-products\/season-average-price-forecasts","description":"This data product provides models and forecasts of season average prices for commodities including corn, soybeans, wheat, and upland cotton. The model forecasts use U.S. futures prices and other publicly available data released by NASS. The model forecasts reflect information about what recent futures prices imply for season average prices and Agricultural Risk Coverage (ARC) and Price Loss Coverage (PLC) programs in the current and upcoming marketing years.","relatedTopics":"118,144,159,173,178,191,194,116","hasInteractiveViz":"0"},{"id":"51","title":"SNAP Policy Data Sets","slug":"snap-policy-data-sets","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-05-06","url":"\/data-products\/snap-policy-data-sets","description":"The SNAP Policy Data Sets contain two components that provide information about State-level SNAP eligibility rules and administrative policies in each of the 50 States and the District of Columbia. The SNAP Policy Database provides information on State policy options in the Supplemental Nutrition Assistance Program (SNAP) from 1996 to 2020. It includes information on State-level SNAP policies relating to eligibility criteria, recertification and reporting requirements, benefit issuance methods, availability of online applications, use of biometric technology (such as fingerprinting), and coordination with other low-income assistance programs. The SNAP Distribution Schedule Database provides the monthly distribution schedule for SNAP benefits from 1998 to 2018.","relatedTopics":"136,153,163,166,167,171,189,125,206","hasInteractiveViz":"1"},{"id":"62","title":"State Agricultural Trade Data","slug":"state-agricultural-trade-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-06-18","url":"\/data-products\/state-agricultural-trade-data","description":"These files include the annually updated State Exports, Cash Receipts Estimates calendar-year data set, which provides the value of exports by State and commodity, and the quarterly updated State Trade by Country of Origin and Destination fiscal-quarter data set, which provides the top five U.S. agricultural import and export commodities and the top countries buying or selling those commodities, by State.","relatedTopics":"119","hasInteractiveViz":"0"},{"id":"70","title":"State Fact Sheets","slug":"state-fact-sheets","type":"Queryable Data Applications","discontinued":"0","lastUpdated":"2026-03-18","url":"\/data-products\/state-fact-sheets","description":"The ERS State Fact Sheets provide information on population, income, poverty, food security, education, employment, farm characteristics, farm financial indicators, top commodities, and agricultural exports. Data are available for all States, and for metro\/nonmetro breakouts within States (and for Puerto Rico if applicable). Links to county-level data are provided where available. ","relatedTopics":"117,150,152,155,172,174,181","hasInteractiveViz":"0"},{"id":"23","title":"Sugar and Sweeteners Yearbook Tables","slug":"sugar-and-sweeteners-yearbook-tables","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-09-02","url":"\/data-products\/sugar-and-sweeteners-yearbook-tables","description":"ERS analysts track U.S. and international sugar and sweetener production, consumption, and trade.","relatedTopics":"151,116","hasInteractiveViz":"1"},{"id":"15","title":"Supplemental Nutrition Assistance Program (SNAP) Data System","slug":"supplemental-nutrition-assistance-program-snap-data-system","type":"Maps","discontinued":"1","lastUpdated":"2026-03-30","url":"\/data-products\/supplemental-nutrition-assistance-program-snap-data-system","description":"Note: Updates to this data product are discontinued. The Supplemental Nutrition Assistance Program (SNAP) Data System provides time-series data on State and county-level estimates of SNAP participation and benefit levels, combined with area estimates of total population and the number of persons in poverty.  ","relatedTopics":"153,156,167,189,125","hasInteractiveViz":"0"},{"id":"47","title":"U.S. Bioenergy Statistics","slug":"us-bioenergy-statistics","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-07-20","url":"\/data-products\/us-bioenergy-statistics","description":"The U.S. Bioenergy Statistics are a source of information on biofuels intended to present a picture of the renewable energy industry and its relationship to agriculture.  Where appropriate, data are presented in both a calendar year and the relevant marketing year timeframe to increase utility to feedstock-oriented users. The statistics highlight the factors that influence the demand for agricultural feedstocks for biofuels production; for instance, numerous tables emphasize the relationship between energy and commodity markets.","relatedTopics":"183,191,116","hasInteractiveViz":"0"},{"id":"72","title":"U.S. Food Imports","slug":"us-food-imports","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-04-08","url":"\/data-products\/us-food-imports","description":"This data set provides import values of edible products (food and beverages) entering U.S. ports and their origin of shipment. Data are from the U.S. Department of Commerce, U.S. Census Bureau. Food and beverage import values are compiled by calendar year into food groups corresponding to major commodities or level of processing. At least twenty years of annual data are included, enabling users to track long-term growth patterns.","relatedTopics":"119","hasInteractiveViz":"0"},{"id":"43","title":"Urban Influence Codes","slug":"urban-influence-codes","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-04-22","url":"\/data-products\/urban-influence-codes","description":"The 2024 Urban Influence Codes are a nine-category county classification based initially on the Office of Management and Budget\u2019s 2023 three classifications\u2014metropolitan, micropolitan, and noncore counties. Metropolitan (metro) counties are divided into two categories based on the population size of the metro area (greater than or less than 1 million people). Micropolitan (micro) counties are divided into three categories based on their adjacency to metro areas of different sizes (adjacent to a large metro, adjacent to a small metro, and nonadjacent). Noncore nonmetropolitan (nonmetro) counties are divided into four categories based on their adjacency to large and small metro areas and the population size of their largest city or town (greater than or less than 5,000 residents). Each county and census-designated county-equivalent in the United States is assigned a code, including those in outlying territories.","relatedTopics":"117,150,152","hasInteractiveViz":"0"},{"id":"106","title":"Vegetables and Pulses Data","slug":"vegetables-and-pulses-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2025-09-22","url":"\/data-products\/vegetables-and-pulses-data","description":"Vegetables and Pulses Data is a collection of resources that provide users with comprehensive statistics on fresh and processed vegetables and dry pulses in the United States, as well as some global data for these sectors. ","relatedTopics":"175,184,116","hasInteractiveViz":"0"},{"id":"34","title":"Weekly Retail Food Sales","slug":"weekly-retail-food-sales","type":"Downloadable Data Files","discontinued":"1","lastUpdated":"2025-12-31","url":"\/data-products\/weekly-retail-food-sales","description":"Note: Updates to this data product are discontinued. Sales of food at retail establishments by week with breakdowns by food category and State.","relatedTopics":"131,120,162,124","hasInteractiveViz":"0"},{"id":"58","title":"Wheat Data","slug":"wheat-data","type":"Downloadable Data Files","discontinued":"0","lastUpdated":"2026-08-13","url":"\/data-products\/wheat-data","description":"This data product contains statistics on wheat\u2014 including domestic wheat data by class as well as international wheat statistics.","relatedTopics":"194,116","hasInteractiveViz":"1"}]},"dataLayer":{"page":{"nid":"7112","chartId":"","pubId":"","title":"Data Products","date":"2025-01-04","type":"","series":"","authors":[],"division":"","breadcrumbs":["Data Products"],"pageName":"","siteSectionSecondLevel":"","siteSectionThirdLevel":"","siteSectionFourthLevel":""}},"csp":{"nonce":"zFww_ErM7pIVuH5d5innMQ"},"user":{"uid":0,"permissionsHash":"6098fea00c5b73e7308eddae5d9abb80b7227c6555765be781c5aa4f4d699378"}}</script>
