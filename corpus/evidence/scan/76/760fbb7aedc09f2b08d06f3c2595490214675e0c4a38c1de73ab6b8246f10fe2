<script type="text/javascript">
    function getParams(name) {
        var param  = location.search.substr(location.search.indexOf("?")+1);
        var name_val = new Array();
        var val='';
        var params = new Array();

        if(name == "month" || name == "year" || name == "view" || name=="log") {
            params = param.split("&");
            for(var i = 0 ; i<params.length; i++) {
                name_val = params[i].split("=");
                if( name_val[0] == name) {//  && name_val[1]%1===0 ) {
                    //console.log("wrheere ...."+name_val[1]);
                    val = name_val[1];
                }
            }
        }
        return val;
    }

    function showMe(id){
        var spanid="span"+id; 
        var divid="div"+id;
        var dotid="dot"+id;
        var ispan=document.getElementById(spanid).style;//.display;
        var idiv=document.getElementById(divid);
        var idot=document.getElementById(dotid).style;
        if(ispan.display=="none"){
            idot.display='none';
            ispan.display='';
            idiv.innerHTML='[-] less';
        } else {
            idot.display='';
            ispan.display='none';
            idiv.innerHTML='[+] more...';
        } 
    }
</script>

