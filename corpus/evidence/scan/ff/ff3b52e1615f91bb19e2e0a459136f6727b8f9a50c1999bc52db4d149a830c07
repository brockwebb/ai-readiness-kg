	const resizeImgBannerMaxWidthFn = function() {
		const imgBanngerContainerEle = document.querySelector('div.cmp-feature__content'); 
		const imgBannerEle = document.querySelector('div.uscb-featured-list-image-container img');

		if (!imgBanngerContainerEle || !imgBannerEle) return;

		const imgBanngerContainerWidth = imgBanngerContainerEle.clientWidth + 'px';
    	const screenFullWidth = '100vw';
    	const screenFullWidthSubImgBanngerContainerWidth = '(' + screenFullWidth + ' - ' + imgBanngerContainerWidth + ')';
    	const marginWidth = '(' + screenFullWidthSubImgBanngerContainerWidth + ' / ' + 2 + ')';
    	let imgBannerWidth = '100%' + ' + ' + marginWidth;
    	imgBannerWidth = 'calc(' + imgBannerWidth + ')';

		imgBannerEle.style.setProperty('max-width', imgBannerWidth);
	}

	const resizeImgBannerHeightFn = function() {
		const imgBanngerContainerEle = document.querySelector('div.cmp-feature__content'); 
		const imgBannerEle = document.querySelector('div.uscb-featured-list-image-container img');

		if (!imgBanngerContainerEle || !imgBannerEle) return;

		const imgBanngerContainerHeight = imgBanngerContainerEle.clientHeight + 'px';
		imgBannerEle.style.height = imgBanngerContainerHeight;
	}

	const resizeFn = function() {
        resizeImgBannerHeightFn();
		resizeImgBannerMaxWidthFn();
	}

	$(window).resize(resizeFn); // bind the resize event handler
	$(document).ready(function() {
    	$(window).trigger('resize'); // on load, init the lastBoundry
	});

</script></div>
