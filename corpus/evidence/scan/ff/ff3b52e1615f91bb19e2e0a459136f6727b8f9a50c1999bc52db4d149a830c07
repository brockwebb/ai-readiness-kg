    $rootScope.selectTopicsFacet = function(topicsFacet, selectionType) {        
        if( selectionType === 'topic' ) {
            //remove any subtopics and flyouttopics for the selected topic facet
            angular.forEach(topicsFacet.subFacets, function(subTopic){
                angular.forEach(subTopic.subFacets, function(flyOutTopic){
                    $rootScope.removeFacet(flyOutTopic, true);
                });
                $rootScope.removeFacet(subTopic, true);
            });
            $rootScope.selectFacet(topicsFacet);
            topicsFacet.selectedFacetClue = $rootScope.getChildTopicFacetCount(topicsFacet);
        }else if( selectionType === 'subtopic' ) {
            //remove the topic and flyout topics of the selected subtopic and finally add the selected subtopic facet.
            //build the parent topic id from the given subtopic id.
            var idSplitted = topicsFacet.id.split('/');
            var parentId = idSplitted[0] + '/' + idSplitted[1];            
            var fetchedParentTopic = $filter('filter')($rootScope.selectedFacets, {id: parentId})[0];            
            
            if( typeof(fetchedParentTopic) !== 'undefined' ) {
                var fetchedFacetIdSplitted = fetchedParentTopic.id.split('/');
                if( fetchedFacetIdSplitted.length == 2 ) {
                    $rootScope.removeFacet(fetchedParentTopic);
                }
            }
            //next, remove any flyout facet of the selected subtopic if found in the selectedFacets array...
            angular.forEach(topicsFacet.subFacets, function(flyOut){
                $rootScope.removeFacet(flyOut, true);
            });
            //now add the subtopic facet
            $rootScope.selectFacet(topicsFacet);
            //now find the parent topic of the selected subtopic facet and assign the selectedFacetClue...
            var parentTopicFacet = $rootScope.fetchFacetById($rootScope.availableTopicFacets, parentId, 'topic');

            if( typeof(parentTopicFacet) !== 'undefined' ) {                
                parentTopicFacet.selectedFacetClue = $rootScope.getChildTopicFacetCount(parentTopicFacet);
                topicsFacet.selectedFacetClue = $rootScope.getChildTopicFacetCount(topicsFacet);
            }
        }else if( selectionType === 'flyouttopic' ) {
            //remove any topic & subtopic level facetws from the selectedFacets array...then add the flyouttopic to the selectedFacets array
            var idSplitted = topicsFacet.id.split('/');
            var parentTopicId = idSplitted[0] + '/' + idSplitted[1];
            var parentSubTopicId = parentTopicId + '/' + idSplitted[2];
            var fetchedParentTopic = $rootScope.fetchFacetById($rootScope.selectedFacets, parentTopicId, 'flat');            
            if( typeof(fetchedParentTopic) !== 'undefined' ){
                $rootScope.removeFacet(fetchedParentTopic, true);
            }
            var fetchedParentSubTopic = $rootScope.fetchFacetById($rootScope.selectedFacets, parentSubTopicId, 'flat');            
            if( typeof(fetchedParentSubTopic) !== 'undefined' ) {
                $rootScope.removeFacet(fetchedParentSubTopic, true);
            }
            //now add the flyout facet...
            $rootScope.selectFacet(topicsFacet);            
            var parentSubTopicFacet = $rootScope.fetchFacetById($rootScope.availableTopicFacets, parentSubTopicId, 'subTopic');            
            if( typeof(parentSubTopicFacet) !== 'undefined' ) {
                parentSubTopicFacet.selectedFacetClue = $rootScope.getChildTopicFacetCount(parentSubTopicFacet);
            }
        }
    };


    $rootScope.fetchFacetById = function(hayStack, needle, level) {        
        var found = false;
        var fetchedFacet;
        if( level === 'topic' ) {
            angular.forEach(hayStack, function(facet){
                if( !found ) {
                    if( facet.id === needle ) {
                        found = true;
                        fetchedFacet = facet;
                    }
                }
            });
        }if( level === 'subTopic' ) {
            angular.forEach(hayStack, function(facet){
                if( !found ) {
                    angular.forEach(facet.subFacets, function(subFacet){
                        if( !found ) {                            
                            if( subFacet.id === needle ) {                                
                                found = true;                                
                                fetchedFacet = subFacet;
                            }
                        }
                    });
                }
            });    
        }else if( level === 'flat' ) {
            angular.forEach(hayStack, function(facet){
                if( !found ) {
                    if( facet.id === needle ) {
                        found = true;
                        fetchedFacet = facet;
                    }
                }
            });
        }
        return fetchedFacet;        
    }

    $rootScope.handleFacetWrapperClick = function (facet) {        
        if (facet.count) {     
            facet.selected = !facet.selected;
            $rootScope.selectFacet(facet);
        }
    };

    /////////////////////end of the new function//////////////////////

    $rootScope.selectFacet = function (facet) {        
        if(facet.selected){            
            $rootScope.addFacet(facet, true);                                  
        } else {            
            $rootScope.removeFacet(facet, true);
        }
        
        setTimeout($rootScope.computeTotalRefinementFacetsWidth, 300);  
        
        if( $rootScope.selectedFacets.length > 0 ) {
            angular.element('.yourRefinementClearAll').show();
        }        
    };
    
    $rootScope.computeTotalRefinementFacetsWidth = function(){          
        var refinementFacetsWidth = 0;
        angular.element('.refinementFacetsContainer > div.uscb-filter-panel-chip').each(function(){
            var context = angular.element(this);    
            refinementFacetsWidth += context.outerWidth( true );            
        });         
        
        if( refinementFacetsWidth > angular.element('#selectedFacets').width() ) {
            angular.element('.seeAllYourRefinements').show();
        }else{
            angular.element('.seeAllYourRefinements').hide();
        }       
    };

    $rootScope.toggleTabOnPress = function(facet, event){
        if (event.which === 32) {
            event.preventDefault();
            $rootScope.toggleTab(facet);
        }
    };
    
    $rootScope.computeSelectedYearFacetLabel = function(facet){        
        if( typeof facet.rangeId !== 'undefined'){
            var fetchedYearSubFacet = null;         
            var lastDigit = facet.rangeId.substr(facet.rangeId.length - 1);
            var lowerBoundary = facet.rangeId - lastDigit;
            var upperBoundary = lowerBoundary + 9;          
            fetchedYearSubFacet = $filter('filter')($rootScope.availableYearFacets.subFacets, {rangeId: upperBoundary })[0];        
            var selectedYearCtr = 0;
            var newestYear = 0;     
                
            for(var i = 0; i < $rootScope.selectedFacets.length; i++) {
                var isNumeric = $rootScope.isNumericValue($rootScope.selectedFacets[i].rangeId);
                if(isNumeric){              
                    var parsedSelectedFacetId = parseInt($rootScope.selectedFacets[i].rangeId);
                    if( parsedSelectedFacetId <= parseInt(upperBoundary) && parsedSelectedFacetId >= parseInt(lowerBoundary) ) {
                        selectedYearCtr++;                  
                        newestYear = parseInt(newestYear) < parsedSelectedFacetId ? parsedSelectedFacetId : newestYear;
                    }
                }
            }//end for...loop
                
            if( fetchedYearSubFacet != null ){          
                if(selectedYearCtr > 1){                    
                    fetchedYearSubFacet.selectedYearFacetClue = selectedYearCtr;
                }else if(selectedYearCtr == 1){                 
                    fetchedYearSubFacet.selectedYearFacetClue = selectedYearCtr;
                }else{
                    fetchedYearSubFacet.selectedYearFacetClue = '';
                }
            }   
        }
    };
    
    $rootScope.isNumericValue = function(val) {    
        if (isNaN(val)) {
            return false;
        }
        var x = parseFloat(val);        
        return (x | 0) === x;
    };
  
    $rootScope.toggleTab = function (facet) {   
        if( facet.subFacets.length > 0 ) {
            facet.isOpen = !facet.isOpen;
            return facet.isOpen;
        }else{            
            if( facet.count > 0 ) {
                facet.selected = !facet.selected;
                $rootScope.selectFacet(facet);
            }
        }
    };

    $rootScope.selectTopicFacetIfSingle = function(facet, selectionType) {
        if( facet.subFacets.length === 0 && facet.selected ) {            
            $rootScope.selectTopicsFacet(facet, selectionType);
        }else{
            facet.selected = !facet.selected;
            $rootScope.selectTopicsFacet(facet, selectionType);
        }
    }
    
    $rootScope.showSubFacetsMobileFilter = function(selectedFacet) {
        if( selectedFacet.facetLevel === '3' ) {            
            $rootScope.selectTopicsFacet(selectedFacet, 'flyouttopic');
        } else if( selectedFacet.subFacets.length === 0 ){            
            $rootScope.selectTopicsFacet(selectedFacet, 'topic');
        } else {            
            $rootScope.selectedMobileFacet = selectedFacet;
            $rootScope.showMobileFilterBox = selectedFacet;
        }            
    };

    $rootScope.showYearSubFacetsMobileFilter = function(selectedFacet) {        
        if( selectedFacet.subFacets.length === 0 ){            
            $rootScope.selectYearFacet(selectedFacet, 'singleYear');
        } else {            
            $rootScope.selectedMobileYearFacet = selectedFacet;
            $rootScope.showMobileYearFilterBox = selectedFacet;
        }            
    };

    $rootScope.showSubFacetsMobileFilterDivClick = function(selectedFacet) {        
        if( selectedFacet.facetLevel === '3' ) {            
            selectedFacet.selected = !selectedFacet.selected;
            $rootScope.selectTopicsFacet(selectedFacet, 'flyouttopic');
        } else if( selectedFacet.subFacets.length === 0 ){   
            selectedFacet.selected = !selectedFacet.selected;         
            $rootScope.selectTopicsFacet(selectedFacet, 'topic');           
        } else {            
            $rootScope.selectedMobileFacet = selectedFacet;
            $rootScope.showMobileFilterBox = selectedFacet;
        }            
    };

    $rootScope.showFacetBoxOnBackClick = function(parentFacetId) {        
        if( parentFacetId === 'All' ) {
            $rootScope.showMobileFilterBox = parentFacetId;
            $rootScope.showMobileYearFilterBox = parentFacetId;
        }else{            
            angular.forEach($rootScope.availableTopicFacets, function(topicFacet){                          
                if( parentFacetId === topicFacet.id ){                    
                    $rootScope.showMobileFilterBox = topicFacet;
                    $rootScope.selectedMobileFacet = topicFacet;                    
                    return;
                }
                angular.forEach(topicFacet.subFacets, function(topicSubFacet){              
                    if( parentFacetId === topicSubFacet.id ){                    
                        $rootScope.showMobileFilterBox = topicSubFacet;
                        $rootScope.selectedMobileFacet = topicSubFacet;                        
                        return;
                    }else{
                        angular.forEach(topicSubFacet.subFacets, function(childFacet){
                            if( parentFacetId === childFacet.id ){                         
                                $rootScope.showMobileFilterBox = childFacet;
                                $rootScope.selectedMobileFacet = childFacet;                                
                                return;
                            }
                        });
                    }
                });
            });            
        }
    };
    
    $rootScope.facetDivClickSelectFacet = function(facet){
        facet.selected = !facet.selected;
        $rootScope.selectFacet(facet);      
    };

    $rootScope.selectProgramsFacetCheckBoxKeyPress = function(facet, keyEvent) {
        if( keyEvent.keyCode == 13 ) {
            $rootScope.facetDivClickSelectFacet(facet);
        }
    };

    $rootScope.toggleExpandYears = function(years, mobile) {
        years.expandYears = !years.expandYears;

        if (years.expandYears) {
            if (mobile) {
                setTimeout(function () {
                    document.getElementsByClassName('mobileExpandYearsCheckBox')[0].focus();
                });
            } else {
