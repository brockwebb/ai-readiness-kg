    $rootScope.toggleExpandTopics = function(topics, topicToFocusIndex, mobile) {
        topics.expandTopics = !topics.expandTopics;

        if (topics.expandTopics) {
            setTimeout(function () {
                var checkBoxSelector = mobile ? "topicsFacetCheckBoxMobile" : "topicsFacetCheckBox";
                var chevronSelection = mobile ? "topicsFacetChevronMobile" : "topicsFacetChevron";
                var checkBox = document.getElementsByClassName(checkBoxSelector)[topicToFocusIndex];
                var chevron = document.getElementsByClassName(chevronSelection)[topicToFocusIndex];

                if (Boolean(chevron) && Boolean(chevron.offsetParent)) {
