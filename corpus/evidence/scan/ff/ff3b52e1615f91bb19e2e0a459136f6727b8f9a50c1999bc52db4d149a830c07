app.controller('ListPagingController', function ($scope, $rootScope, FacetService) {    
    $scope.PAGE_SIZE = 36;
    $scope.MAX_PAGES = 10;
    $scope.currentStartRow = 1;
      
    var getPager = function(currentPage) {
        currentPage = currentPage || 1;
        var totalPages = Math.ceil($rootScope.numResultsFound/$scope.PAGE_SIZE);
        var startPage, endPage;
        if (totalPages <= $scope.MAX_PAGES) {
            startPage = 1;
            endPage = totalPages;
        } else {
            if (currentPage <= 6) {
                startPage = 1;
                endPage = 10;
            } else if (currentPage + 4 >= totalPages) {
                startPage = totalPages - 9;
                endPage = totalPages;
            } else {
                startPage = currentPage - 5;
                endPage = currentPage + 4;
            }

            // handle 3 digits number, when total pages greater than 100
            if (window.innerWidth >= 1280) {
                if (currentPage >= 99 && totalPages >= 100) {
                    endPage -= 1;
                }
            } else if (window.innerWidth >= 993) {
                if (currentPage >= 96 && totalPages >= 100) {
                    startPage += 3
                    endPage -= 1;
                }
            } 

        }
        var pages = new Array();
        for (var i=startPage; i<=endPage; i++)
            pages[pages.length] = i;
 
        // return object with all pager properties required by the view
        return {
            currentPage: currentPage,
            totalPages: totalPages,
            startPage: startPage,
            endPage: endPage,
            pages: pages
        };
    };
    
    if (!$rootScope.pager)
        $rootScope.pager = getPager(1);
        
    $scope.setPage = function(page) {
        if (page < 1 || page > $rootScope.pager.totalPages || page==$rootScope.pager.currentPage) {
            return;
        }
        $rootScope.pager = getPager(page);
        $scope.currentStartRow = ($scope.pager.currentPage - 1) * $scope.PAGE_SIZE;
        $rootScope.startRow = $scope.currentStartRow;
        FacetService.sendFacets(false, false);
    };

    $scope.setPageKeyPress = function(page, keyEvent) {
        if( keyEvent.keyCode == 13 ) {
            $scope.setPage(page);
        }
    };
    
    $rootScope.resetPager = function() {
        $rootScope.pager = getPager(1);
        $scope.currentStartRow = 0;
        $rootScope.startRow = 0;
    }   
});

app.factory('FacetService', function ($rootScope, $http, $log) {
    
    var getBaseTags = function() {
        var baseTags = new Array();
        for (var i=0; i<baseFilterTags.length; i++) {
            baseTags[baseTags.length]=baseFilterTags[i].id;
        }
        return baseTags;
    }
    var getGroupFacets = function(group) {
        var groupFacets = new Array();
        for (var i=0; i<$rootScope.selectedFacets.length; i++) {
            var facet = $rootScope.selectedFacets[i];
            if (facet.id.lastIndexOf(group, 0)===0 && !facet.permanent)
                groupFacets[groupFacets.length]=facet.id;
        }
        return groupFacets;
    }
    var getYearFacets = function() {
        var yearFacets = new Array();
        for (var i=0; i<$rootScope.selectedFacets.length; i++) {
            var facet = $rootScope.selectedFacets[i];
            if (facet.id.match(/^[0-9]{3,4}$/g)) {
                yearFacets[yearFacets.length]=facet.id;
            } 
        }
        return yearFacets;
    }
    var updateFacetGroups = function(facets) {
        angular.element($(".facetContainer")).addClass('hiddenFacet');
        for (var i=0; i<facets.length; i++) {   
            var facetId = facets[i].facetName;
            var id =  facetId.replace( /(:|\/)/g, "\\$1" );
            if (facetId.lastIndexOf($rootScope.timeTagPrefix, 0)===0 && facetId.length>4) 
                id = facetId.substring(facetId.length-4);
            angular.element($("#" + id))
                .removeClass('hiddenFacet')
                .parents('.facetContainer')
                .removeClass('hiddenFacet');
        }   
    }
    
    var findFacetById = function(id, facets) {
        var result = null;
        for (var i=0; facets && i<facets.length && result==null; i++) {     
            if (id==facets[i].id) 
                result = facets[i];
            else if (facets[i].subFacets) 
                result = findFacetById(id, facets[i].subFacets);
        }
        return result;
    }
       var parentCountSum = function(facet) {        
            var count = facet.count;
            angular.forEach(facet.subFacets, function(subFacet){  
                    if(subFacet.count > 0){
                        count = count +subFacet.count;
                    }           
            });        
            return count;
        }
        
    var updateFacetCounts = function(counts) {
        var lastFacetId = ($rootScope.lastSelectedFacet ? $rootScope.lastSelectedFacet.id : '');
        
        for (var i=0; i<counts.length; i++) {
            var countGroup = counts[i].facetField;
            var facet;
            if (countGroup=="topics")
                facet = findFacetById(counts[i].facetName, $rootScope.availableTopicFacets);
            else if (countGroup=="programs" && lastFacetId.lastIndexOf($rootScope.programTagPrefix, 0)===-1) {
                facet = findFacetById(counts[i].facetName, $rootScope.availableAllProgramsAndSurveysFacet); 
                if (facet==null)
                    facet = findFacetById(counts[i].facetName, $rootScope.mostPopularProgramFacets);
            } else {
                facet = findFacetById(counts[i].facetName, $rootScope.availableYearFacets.subFacets);
            }
            if (facet!=null)
                facet.count =counts[i].count;//parentCountSum(facet); //
        }
    }
    var resetFacetCounts = function(facets) {
        for (var i=0; i<facets.length; i++) {
            facets[i].count = 0;
            if (facets[i].subFacets && facets[i].subFacets.length>0)
                resetFacetCounts(facets[i].subFacets);
        }
    }
    var resetAllFacetCounts = function() {
        if ($rootScope.lastSelectedFacet) {
            var lastFacetId = $rootScope.lastSelectedFacet.id;
            if (lastFacetId.lastIndexOf($rootScope.programTagPrefix, 0)===0) {
                resetFacetCounts($rootScope.availableTopicFacets);
                resetFacetCounts($rootScope.availableYearFacets.subFacets);
                //resetFacetCounts($rootScope.mostPopularProgramFacets);
            } else if (lastFacetId.lastIndexOf($rootScope.topicTagPrefix, 0)===0) {
                //resetFacetCounts($rootScope.availableTopicFacets);
                resetFacetCounts($rootScope.mostPopularProgramFacets);
                resetFacetCounts($rootScope.availableAllProgramsAndSurveysFacet);   
                resetFacetCounts($rootScope.availableYearFacets.subFacets);
            } else if (lastFacetId.match(/^[0-9]{4}$/g)) {
                resetFacetCounts($rootScope.mostPopularProgramFacets);
                resetFacetCounts($rootScope.availableAllProgramsAndSurveysFacet);   
                resetFacetCounts($rootScope.availableTopicFacets);
                //resetFacetCounts($rootScope.availableYearFacets.subFacets);
            }
        }
    }

    var updateBaseFilterTags = function(baseFilterTags) {
        // Select and disabled base tag facets
        for (var i=0; i<baseFilterTags.length; i++) {   
            var id =  baseFilterTags[i].id.replace( /(:|\/)/g, "\\$1" );
            angular.element($("#" + id)).addClass('baseTag');
            angular.element($("#" + id + "_cb"))
                .prop('checked',true)
                .attr('disabled','true');
        }
    }
    var sendAnalytics = function() {        
        var baseTags = (getBaseTags() + '').replace(/,/g," | ").replace(/Census\:[a-zA-Z]+\//g,'');
        var topicTags = (getGroupFacets($rootScope.topicTagPrefix) + " | ").replace(/,/g," | ").replace(/Census\:[a-zA-Z]+\//g,'');
        var programTags = (getGroupFacets($rootScope.programTagPrefix) + " | ").replace(/,/g," | ").replace(/Census\:[a-zA-Z]+\//g,'');
        var yearTags = (getYearFacets() + '').replace(/,/g," | ");
        
        digitalData.event.eventName = 'Click';
        digitalData.event.eventInfo.faceted.linkTrackVars = 'eVar72, events';
        digitalData.event.eventInfo.faceted.linkTrackEvents = 'event70';
        digitalData.event.eventInfo.faceted.events = 'event70';
        digitalData.event.eventInfo.faceted.eVar72 = (baseTags + " ^ " + topicTags + programTags + yearTags + " ^ " + $rootScope.numResultsFound).replace(/(\| \|)/g,'');
    }
    return {
        updateBaseFilterTags: function(baseFilterTags) {
            updateBaseFilterTags(baseFilterTags);
        },
        sendFacets: function(resetPaging, updateFacets) {
            var $initialList = $(".data-uscb-list-articles-container");
            var $facetedArticles = $("#facetedListArticles");
            var $loadingIndicator = $("#uscb-facet-list-loading-indicator");

            $initialList.hide();
            $facetedArticles.hide();
            $loadingIndicator.show();

            $http({
                url: '/bin/faceted/getfacets',
                method: "POST",
                data: { baseTags: getBaseTags(), 
                        documentPath: baseDocumentPath,
                        matchType: initialMatchAny,
                        programs: getGroupFacets($rootScope.programTagPrefix),
                        topics: getGroupFacets($rootScope.topicTagPrefix),                  
                        years: getYearFacets(),  
                        geographies:getGroupFacets($rootScope.geographyTagPrefix), 
                        authors:[],
                        startRow: (resetPaging? 0: $rootScope.startRow), 
                        sortBy: $rootScope.sortBy},
                headers: {'Content-Type': '"application/json;"'}
            }).success(function (data, status, headers, config) {
                var staticList = angular.element($(".data-uscb-list-articles-container"));
                staticList.html('');
                $rootScope.numResultsFound = data.numDocuments;
                $rootScope.listArticles = data.documents;
                
                // redo base filter tags checkboxes
                updateBaseFilterTags(baseFilterTags);
                if (updateFacets) {
                    resetAllFacetCounts();
                    updateFacetCounts(data.facetCounts);
                }
                if (resetPaging) {
                    $rootScope.resetPager();
                }
                // if ( updateFacets && typeof(digitalData) != 'undefined' ){
                //     sendAnalytics();
                // }
            }).error(function (data, status, headers, config) {
                //$scope.status = status;//Is it to mean $rootScope?
            }).finally(function() {
                $loadingIndicator.hide();
                $initialList.show();
                $facetedArticles.show();
            })
        },
    };
});

