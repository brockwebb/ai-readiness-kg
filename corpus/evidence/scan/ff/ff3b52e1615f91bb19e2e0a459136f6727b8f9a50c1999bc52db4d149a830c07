    $rootScope.selectYearFacet = function(yearFacet, selectionType) {        
        if( selectionType === 'singleYear' ) {
            $rootScope.selectFacet( yearFacet );
        }else if( selectionType === 'yearRange' ) {
            //First remove any pre-selected single year in the given year range...then add the year range...
            var yearFacetTitleSplitted = yearFacet.title.split(' - ');
            for(var i = yearFacetTitleSplitted[0]; i <= yearFacetTitleSplitted[ yearFacetTitleSplitted.length - 1 ]; i++ ) {
                var fetchedYearFlyOutFacet = $filter('filter')($rootScope.selectedFacets, {id: i.toString() })[0];
                if( typeof(fetchedYearFlyOutFacet) !== 'undefined' ) {
                    $rootScope.removeFacet( fetchedYearFlyOutFacet, true );
                }                
            }//end for...loop
            $rootScope.selectFacet( yearFacet );
            yearFacet.selectedYearFacetClue = $rootScope.getChildYearFacetCount( yearFacet );
        }else if( selectionType === 'flyOutFacet' ) {
            //First remove the range year if its already selected. e.g if 2000 - 2009 was in the refinement box, when clicking at 2007 drop the range and add the 2007 year.            
            var startYear = parseInt(yearFacet.title);//( parseInt(yearFacet.title) / 10 ) * 10;
            startYear = Math.floor(startYear / 10) * 10;
            var endYear = startYear + 9;
            var rangeYearTitle = startYear + ' - ' + endYear;            
            var fetchedYearRangeFacet = $filter('filter')($rootScope.selectedFacets, {title: rangeYearTitle})[0];            
            if( typeof(fetchedYearRangeFacet) !== 'undefined' ) {
                $rootScope.removeFacet(fetchedYearRangeFacet);                
            }
            $rootScope.selectFacet(yearFacet);    
            var yearRangeFacet = $filter('filter')($rootScope.availableYearFacets.subFacets, {title: rangeYearTitle})[0];     
            yearRangeFacet.selectedYearFacetClue = $rootScope.getChildYearFacetCount(yearRangeFacet);
        }
    };

