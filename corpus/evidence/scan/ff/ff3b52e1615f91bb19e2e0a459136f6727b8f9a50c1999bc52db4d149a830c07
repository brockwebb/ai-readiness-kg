app.controller('RefinementsFacetController', function ($rootScope, FacetService) {
    
    $rootScope.toggleExpandRefinementFacets = function(refinementFacets) {      
        refinementFacets.expandFacetContainer = !refinementFacets.expandFacetContainer;
        return refinementFacets.expandFacetContainer;
    };

    $rootScope.toggleExpandRefinementFacetsKeyPress = function(refinementFacets, keyEvent) {
        if (keyEvent.keyCode === 13 || keyEvent.keyCode === 32) {
            keyEvent.preventDefault();
            $rootScope.toggleExpandRefinementFacets(refinementFacets);
        }
    };
    
    $rootScope.addFacet = function(facet, sendFacets) {
        $rootScope.selectedFacets[$rootScope.selectedFacets.length] = facet;
        $rootScope.lastSelectedFacet = facet;
        if (sendFacets){
            FacetService.sendFacets(true, true);
        }       
    };

    $rootScope.removeFacetKeyPress = function(facet, sendFacets, keyEvent) {
        if (keyEvent.keyCode === 13 || keyEvent.keyCode === 32) {
            keyEvent.preventDefault();
            $rootScope.removeFacet(facet, sendFacets);
        }
    };
    
    $rootScope.removeFacet = function(facet, sendFacets) {
        //remove only if the facet exists  
        if($rootScope.selectedFacets.indexOf(facet) != -1){
            facet.selected = false;
            $rootScope.selectedFacets.splice($rootScope.selectedFacets.indexOf(facet), 1);          
            $rootScope.lastSelectedFacet = facet;
            if (sendFacets){
                FacetService.sendFacets(true, true);
            }
            //now do the width calculation here in order to show/hide the more/less link for the refinement facet box
            var refinementFacetsWidth = 0;
                        
            angular.element('.refinementFacetsContainer > div').each(function(){
                var context = angular.element(this);                
                refinementFacetsWidth += context.outerWidth();
            });         
            if( refinementFacetsWidth > (angular.element('#selectedFacets').width() - 52) ) {               
                angular.element('.seeAllYourRefinements').show();               
            }else{
                angular.element('.seeAllYourRefinements').hide();
            }               
            
            setTimeout($rootScope.computeTotalRefinementFacetsWidth, 300);                          
        }
        
        if( $rootScope.selectedFacets.length < 1 ) {            
            angular.element('.yourRefinementClearAll').hide();
        }
        
        //now update the selection count value..
        $rootScope.updateSelectedTopicFacetCount(facet);
        $rootScope.updateSelectedYearFacetCount(facet);
    };
    
    $rootScope.updateSelectedTopicFacetCount = function(facet) {
        angular.forEach($rootScope.availableTopicFacets, function(topicFacet){          
            //For updating the 'All' from the facet count value
            if( facet.id === topicFacet.id ){
                facet.selectedFacetClue = '';
            }
            angular.forEach(topicFacet.subFacets, function(topicSubFacet){              
                if(facet.id === topicSubFacet.id && facet.subFacets.length > 0){                    
                    $rootScope.selectTopicSubFacet(facet);
                    //resets the facet clue for parent facet
                    $rootScope.selectTopicSubFacet(topicFacet);
                    return;
                }else if(facet.id === topicSubFacet.id && facet.subFacets.length == 0){
                    //These are direct children of a topic facet                    
                    $rootScope.selectTopicSubFacet(topicFacet);
                    return;
                }else{
                    angular.forEach(topicSubFacet.subFacets, function(childFacet){
                        if(facet.id === childFacet.id){                         
                            $rootScope.selectTopicFlyOutFacet(topicSubFacet);
                            return;
                        }
                    });
                }
            });
        });
    };
    
    $rootScope.updateSelectedYearFacetCount = function(facet) {        
        angular.forEach($rootScope.availableYearFacets.subFacets, function(yearSubFacet){
            if(facet.id == yearSubFacet.id && yearSubFacet.subFacets.length > 0){               
                facet.selectedYearFacetClue = $rootScope.getChildYearFacetCount(yearSubFacet);
                return;
            }else{
                angular.forEach(yearSubFacet.subFacets, function(yearChildFacet){
                    if(facet.id === yearChildFacet.id){                     
                        yearSubFacet.selectedYearFacetClue = $rootScope.getChildYearFacetCount(yearSubFacet);
                        return;
                    }
                });
            }
        });
    };

    $rootScope.clearAllRefinementFacetsKeyPress = function(keyEvent) {
        if (keyEvent.keyCode === 13 || keyEvent.keyCode === 32) {
            keyEvent.preventDefault();
            $rootScope.clearAllRefinementFacets();
        }
    };    
    
    $rootScope.clearAllRefinementFacets = function() {    
        angular.forEach($rootScope.availableTopicFacets, function(facet){  
            facet.selectedAll = false;
            facet.selected = false; 
            facet.selectedFacetClue = "";
            angular.forEach(facet.subFacets, function(subFacet){                                
                subFacet.selected = false;
                subFacet.flyOutSelectedAll = false;  
                subFacet.selectedFacetClue = "";
                angular.forEach(subFacet.subFacets, function(flyOutFacet){                      
                    flyOutFacet.selected = false;                   
                });
            });
            angular.element('.yourRefinementClearAll').hide();              
        });
        
        angular.forEach($rootScope.availableYearFacets.subFacets, function(subFacet){           
            subFacet.selected = false;  
            subFacet.selectedAll = false;
                        
            angular.forEach(subFacet.subFacets, function(subFacet){
                subFacet.selected = false;
                $rootScope.computeSelectedYearFacetLabel(subFacet);                 
            });             
            subFacet.selectedYearFacetClue = "";
        });     
        
        $rootScope.availableYearFacets.selectedAll = false;
        angular.forEach($rootScope.mostPopularProgramFacets, function(facet){
            facet.selected = false;
        });
        
        angular.forEach($rootScope.availableAllProgramsAndSurveysFacet, function(facet){
            facet.selected = false;
        });
        
        $rootScope.selectedFacets = [];
        $rootScope.lastSelectedFacet = null;
        
        FacetService.sendFacets(true, true);
        
        angular.element('.seeAllYourRefinements').hide();
    };
});

