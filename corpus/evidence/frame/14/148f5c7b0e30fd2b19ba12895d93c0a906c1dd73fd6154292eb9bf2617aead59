reauCode":["021:00"],"issued":"2023-10-17","@type":"dcat:Dataset","modified":"2026-05-05","keyword":["inbound border crossing entries"],"contactPoint":{"@type":"vcard:Contact","fn":"BTS Port Performance Freight Statistics Program","hasEmail":"mailto:portstatistics@dot.gov"},"publisher":{"@type":"org:Organization","name":"Bureau of Transportation Statistics"},"identifier":"https://data.bts.gov/api/views/jswi-2e7b","description":"The Bureau of Transportation Statistics (BTS) Border Crossing Data provide summary statistics for inbound crossings at the U.S.-Canada and the U.S.-Mexico border at the port level.  Data are available for trucks, trains, containers, buses, personal vehicles, passengers, and pedestrians.  Border crossing data are collected at ports of entry by U.S. Customs and Border Protection (CBP).  The data reflect the number of vehicles, containers, passengers, and pedestrians entering the United States through CBP facilities.  CBP does not collect comparable data on outbound crossings. BTS also does not collect data about the size or number of seats per bus. Users seeking more detailed data such as outbound counts may therefore want to review information from individual bridge operators, border state governments, or the Mexican and Canadian governments.","title":"Border Crossing Data","programCode":["021:053"],"dataQuality":true,"license":"http://www.usa.gov/publicdomain/label/1.0/","accrualPeriodicity":"R/P1M","theme":["Research and Statistics"],"language":["en-US"]},{"accessLevel":"public","landingPage":"https://data.bts.gov/d/jt8n-q46j","bureauCode":["021:00"],"issued":"2024-01-12","@type":"dcat:Dataset","modified":"2026-09-29","keyword":["water transportation"],"contactPoint":{"@type":"vcard:Contact","fn":"BTS Port Performance Freight Statistics Program","hasEmail":"mailto:portstatistics@dot.gov"},"publisher":{"@type":"org:Organization","name":"Bureau of Transportation Statistics"},"identifier":"https://data.bts.gov/api/views/jt8n-q46j","description"