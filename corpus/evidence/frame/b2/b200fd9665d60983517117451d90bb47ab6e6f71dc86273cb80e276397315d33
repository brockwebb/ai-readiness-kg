  <script>
    window.addEventListener("load", function () {
      const headings = document.querySelectorAll("h2");
      const jumpLinks = document.querySelectorAll(".ies-jump-link");
      const validIds = Array.from(jumpLinks).map(link => link.getAttribute("href").replace("#", "")).filter(id => id.trim() !== "");
      const linkHeadings = Array.from(headings).filter(heading => validIds.includes(heading.id));
      function setActiveLink() {
        let currentActive = null;
        linkHeadings.forEach((heading, index) => {
          const sectionTop = heading.getBoundingClientRect().top;
          const sectionHeight = heading.offsetHeight;
          if(sectionTop <= window.innerHeight / 12 && sectionTop + sectionHeight > window.innerHeight / 12) {
            currentActive = jumpLinks[index];
          }
        });
        if (currentActive) {
          jumpLinks.forEach((link) => {
            link.classList.remove("ies-jump-link--active");
          });
          currentActive.classList.add("ies-jump-link--active");
        }
      }
      jumpLinks.forEach(link => {
        //Check for empty link and change display to none
        if(link.textContent.trim() === ''){
          link.classList.add("ies-jump-link-no-display");
        }
        link.addEventListener("click", function (event) {
          document.removeEventListener("scroll", setActiveLink);
          const href = link.getAttribute("href");
          if (href.startsWith("#")) {
            event.preventDefault();
            document.location = href;
          } else {
            window.location.href = href;
          }
          jumpLinks.forEach(link => link.classList.remove("ies-jump-link--active"));
          this.classList.add("ies-jump-link--active");
          setTimeout(() => {
            document.addEventListener("scroll", setActiveLink);
            setActiveLink();
          }, 500);
        });
      });
      document.addEventListener("scroll", setActiveLink);
    });
  </script>
